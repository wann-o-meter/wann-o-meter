# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# python
__pycache__/
*.pyc
.pytest_cache/

# pipeline working state (fetched documents + extracted-but-not-yet-reviewed
# candidates) - not source data, and can hold large PDFs/images.
# pipeline/review-state/ is deliberately NOT ignored: it's the review
# decision history (approved/rejected/modified), meant to be committed.
pipeline/staging/

# Sent/drafted consent requests - they contain third-party email addresses.
# pipeline/config/consent.yaml (the decisions themselves) IS committed: it
# gates the crawler and every approval, so it belongs in the repo.
pipeline/consent-outbox/

# Claude Code agent worktrees - ephemeral, and their presence under the repo
# root was making vitest double-count every test file it happened to contain
.claude/

PLAN.md

# SSH deploy keypair for the gh-pages push - private key, never commit it.
# Untracked but unignored is one `git add -A` away from being published, and
# a key in history survives `git rm` (it needs filter-repo/BFG to remove).
gh-pages-deploy
gh-pages-deploy.pub
