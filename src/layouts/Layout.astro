---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { House, ListChecks, Monitor, Moon, Search, Sun } from "@lucide/astro";
import { loadAllVorhaben } from "../../lib/vorhaben-data";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  structuredData?: object;
  noindex?: boolean;
  // Where this page's content really lives, when it is a working surface for
  // another address rather than a page of its own.
  canonical?: string;
}
const {
  title,
  description,
  wide = false,
  structuredData,
  noindex = false,
  canonical,
} = Astro.props;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, Astro.site).href;
// The site name in the tab, the bookmark and every unfurl. Google drops it
// where it renders the site name itself, so it only costs a page whose own
// title already fills the width Google shows.
const pageTitle = title.length > 55 ? title : `${title} | Wann-O-Meter`;
// Every Vorhaben is reachable from every page: the startpage picker is a set
// of buttons, so without this the plan pages have no incoming internal links.
const vorhabenLinks = loadAllVorhaben().map((v) => ({
  href: `/${v.slug}/`,
  label: v.label,
}));
const ogDescription =
  description ?? "Strukturierte Antworten auf Wann-Fragen, als Kalender-Abo.";
// One publisher for the whole site, so every page names the same entity instead
// of each page standing on its own.
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Wann-O-Meter",
  url: new URL("/", Astro.site).href,
  logo: new URL("/web-app-manifest-512x512.png", Astro.site).href,
};
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t === "light" || t === "dark")
        document.documentElement.dataset.theme = t;
      // Runs before the first paint, so anything an island replaces later never
      // gets drawn and then pulled away.
      document.documentElement.dataset.js = "1";
    </script>
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <!-- RFC 9727 allows the catalog to be advertised in the markup as well as
    in a Link header, and a static host can only do the markup half. -->
    <link rel="api-catalog" href="/.well-known/api-catalog" />
    <link rel="service-desc" type="application/json" href="/openapi.json" />
    <link rel="service-doc" type="text/html" href="/api/" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content="Wann-O-Meter" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content={new URL("/og-image.png", Astro.site).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta
      name="twitter:image"
      content={new URL("/og-image.png", Astro.site).href}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organization)}
    />
    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    <ClientRouter />
  </head>
  <body>
    <header>
      <div class:list={["wrap", "header-bar", { wide }]}>
        <a href="/" class="brand"
          >Wann-<span class="brand-accent">O</span>-Meter</a
        >
        <div class="header-actions">
          <a href="/" class="home icon-button" aria-label="Zur Startseite" title="Zur Startseite">
            <House size={16} />
          </a>
          <button
            type="button"
            id="theme-toggle"
            class="theme-toggle"
            title="Farbschema wechseln (System/Hell/Dunkel)"
          >
            <Monitor size={16} data-theme-icon="system" class="active" />
            <Sun size={16} data-theme-icon="light" />
            <Moon size={16} data-theme-icon="dark" />
            <span data-theme-label>System</span>
          </button>
        </div>
      </div>
    </header>
    <main class:list={["wrap", { wide }]}>
      <slot />
    </main>
    <!-- Thumb reach on a phone. The middle slot is filled by whatever island
    owns the page, so the plus always does the thing the page is about. -->
    <nav class="tabbar" aria-label="Bereiche">
      <a href="/"><House size={20} /><span>Start</span></a>
      <a href="/#plaene"><ListChecks size={20} /><span>Pläne</span></a>
      <div id="fab-slot"></div>
      <a href="/#fristen"><Search size={20} /><span>Fristen</span></a>
    </nav>

    <footer>
      <div class:list={["wrap", "footer-bar", { wide }]}>
        <nav class="footer-nav" aria-label="Zeitpläne">
          Zeitpläne:{" "}
          {
            vorhabenLinks.map((v, i) => (
              <>
                {i > 0 && <span aria-hidden="true"> &middot; </span>}
                <a href={v.href}>{v.label}</a>
              </>
            ))
          }
          <span aria-hidden="true"> &middot; </span>
          <a href="/frist/">Alle Fristen</a>
        </nav>
        <p>
          Angaben ohne Gewähr, keine Rechtsberatung.{" "}
          <a href="/impressum/#ki">Wie die Inhalte entstehen</a>.
        </p>
        <p>
          <a href="/impressum">Impressum</a> &middot; <a href="/datenschutz"
            >Datenschutz</a
          > &middot;{" "}
          <a href="/einbetten/">Einbetten</a> &middot;{" "}
          <a href="/api/">API</a> &middot;{" "}
          <a href="/feedback">Feedback geben</a>
        </p>
      </div>
    </footer>

    <script>
      // A view transition replaces the html attributes with the ones the server
      // sent, and the js flag is not among them. Without this the pre-hydration
      // fallback comes back on every soft navigation.
      document.addEventListener("astro:before-swap", (event) => {
        event.newDocument.documentElement.dataset.js = "1";
      });

      document.addEventListener("astro:page-load", () => {
        const THEME_LABELS = {
          system: "System",
          light: "Hell",
          dark: "Dunkel",
        };
        const themeToggle = document.getElementById("theme-toggle");
        function currentTheme() {
          const t = localStorage.getItem("theme");
          return t === "light" || t === "dark" ? t : "system";
        }
        function renderThemeToggle() {
          const t = currentTheme();
          if (t === "system") delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = t;
          if (!themeToggle) return;
          themeToggle.setAttribute(
            "aria-label",
            `Farbschema: ${THEME_LABELS[t]}`,
          );
          const label = themeToggle.querySelector("[data-theme-label]");
          if (label) label.textContent = THEME_LABELS[t];
          for (const icon of themeToggle.querySelectorAll(
            "[data-theme-icon]",
          )) {
            icon.classList.toggle(
              "active",
              icon.getAttribute("data-theme-icon") === t,
            );
          }
        }
        renderThemeToggle();
        themeToggle?.addEventListener("click", () => {
          const order = ["system", "light", "dark"];
          const next =
            order[(order.indexOf(currentTheme()) + 1) % order.length];
          if (next === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
          renderThemeToggle();
        });
      });

    </script>
  </body>
</html>

<style>
  .wrap {
    --wrap-pad: 1rem;
    max-width: 62rem;
    margin: 0 auto;
    padding-left: var(--wrap-pad);
    padding-right: var(--wrap-pad);
  }
  .wrap.wide {
    max-width: 88rem;
  }
  @media (min-width: 30rem) {
    .wrap {
      --wrap-pad: 2rem;
    }
  }

  header {
    border-bottom: 1px solid var(--line);
  }
  .header-bar {
    padding-top: 1rem;
    padding-bottom: 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
  }
  .brand {
    font-weight: var(--fw-semibold);
    font-size: var(--t-body);
    color: var(--ink);
    text-decoration: none;
  }
  .brand .brand-accent {
    color: var(--accent);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .home {
    border-color: var(--line);
    background: var(--paper-raised);
    color: var(--ink);
  }
  /* The bottom bar already has Start on a phone. */
  @media (max-width: 40rem) {
    .home {
      display: none;
    }
  }
  .theme-toggle span {
    font-size: var(--t-meta);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.5rem;
  }
  .theme-toggle [data-theme-icon] {
    display: none;
  }
  .theme-toggle [data-theme-icon].active {
    display: block;
  }

  main {
    padding-top: 3rem;
    padding-bottom: 5rem;
  }
  @media (max-width: 36rem) {
    .header-bar {
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }
    main {
      padding-top: 1.5rem;
    }
  }

  .tabbar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: grid;
    grid-template-columns: 1fr 1fr auto 1fr;
    align-items: center;
    padding: 0.3rem 0.5rem calc(0.3rem + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    background: var(--paper-raised);
  }
  .tabbar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.35rem 0;
    color: var(--muted);
    font-size: var(--t-meta);
    text-decoration: none;
  }
  .tabbar a:hover {
    color: var(--accent);
  }
  #fab-slot {
    display: flex;
    justify-content: center;
    width: 4.5rem;
  }
  /* Nothing teleported in, so it takes no room. */
  #fab-slot:empty {
    width: 0;
  }
  /* Room for the bar, so it never sits on the last line of a page. */
  body {
    padding-bottom: 4.5rem;
  }
  @media (min-width: 40rem) {
    .tabbar {
      display: none;
    }
    body {
      padding-bottom: 0;
    }
  }
  /* Scoped, so it outweighs the grid above that the global print block cannot
  reach. */
  @media print {
    .tabbar {
      display: none;
    }
    body {
      padding-bottom: 0;
    }
  }

  footer {
    margin-top: 4.5rem;
    border-top: 1px solid var(--line);
  }
  .footer-bar {
    padding-top: 1.5rem;
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .footer-bar p {
    margin: 0 0 0.5rem;
  }
  .footer-nav {
    margin-bottom: 0.5rem;
  }
</style>
