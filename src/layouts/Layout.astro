---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { Monitor, Moon, Search, Sun } from "@lucide/astro";
import {
  feedbackIssueUrl,
  feedbackMailtoUrl,
  newSourceIssueUrl,
} from "../../lib/github-issue";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  // Pre-built JSON-LD document from lib/structured-data.ts's graph() - kept
  // as a plain prop instead of a named slot so every page can pass it
  // without needing to know about <script> placement.
  structuredData?: object;
  // "follow", not "none": the page stays out of the index but its links still
  // pass through to the year pages that ARE indexable (lib/year-pages.ts).
  noindex?: boolean;
}
const {
  title,
  description,
  wide = false,
  structuredData,
  noindex = false,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const pageTitle = `${title} · Wann-O-Meter`;
const ogDescription =
  description ?? "Strukturierte Antworten auf Wann-Fragen, als Kalender-Abo.";
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Applies a saved light/dark override before first paint, so there's
      // no flash of the wrong theme - runs synchronously as the very first
      // thing in <head>. No override stored (or "system") means the
      // prefers-color-scheme media query in global.css decides, same as
      // before this toggle existed.
      const t = localStorage.getItem("theme");
      if (t === "light" || t === "dark")
        document.documentElement.dataset.theme = t;
    </script>
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:site_name" content="Wann-O-Meter" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      property="og:image"
      content={new URL("/og-image.png", Astro.site).href}
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta
      name="twitter:image"
      content={new URL("/og-image.png", Astro.site).href}
    />

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        />
      )
    }

    {
      /* Swaps the document instead of reloading it, so the year pills in
        DateListControls navigate without a full-page flash - they change the
        URL (each year is its own static page) but feel like an in-place
        filter. Consequence for every script below: a module script runs ONCE,
        so anything that binds to per-page DOM has to re-run on
        astro:page-load or it silently stops working after the first swap. */
    }
    <ClientRouter />
  </head>
  <body>
    <header>
      <div class:list={["wrap", "header-bar", { wide }]}>
        <a href="/" class="brand"
          >Wann-<span class="brand-accent">O</span>-Meter</a
        >
        <button
          type="button"
          id="theme-toggle"
          class="theme-toggle"
          title="Farbschema wechseln (System/Hell/Dunkel)"
        >
          <Monitor size={16} data-theme-icon="system" class="active" />
          <Sun size={16} data-theme-icon="light" />
          <Moon size={16} data-theme-icon="dark" />
        </button>
      </div>
    </header>
    <main class:list={["wrap", { wide }]}>
      <slot />
    </main>
    <footer>
      <div class:list={["wrap", "footer-bar", { wide }]}>
        <p>Angaben ohne Gewähr, keine Rechtsberatung.</p>
        <p>
          <a href="/impressum">Impressum</a> &middot; <a href="/datenschutz"
            >Datenschutz</a
          > &middot;{" "}
          <a href={newSourceIssueUrl()}>Quelle vorschlagen</a> &middot; Feedback:{
            " "
          }
          <a href={feedbackMailtoUrl()}>Mail</a> &middot; <a
            href={feedbackIssueUrl()}>GitHub</a
          >
        </p>
      </div>
    </footer>

    <script>
      // Client-side, not Astro frontmatter: this is a static build, so a
      // date computed at build time would freeze at whenever the site was
      // last built, not update as real days/weeks pass for a visitor.
      import { formatTodayLabel } from "../../lib/date-display";

      // Everything that touches elements INSIDE <body> runs per navigation:
      // <ClientRouter /> swaps the body, so the nodes this found on first load
      // are gone afterwards and any listener on them went with it.
      // astro:page-load also fires on the initial load, so this is not a
      // behaviour change for a normal page visit. (The Cmd+K handler at the
      // bottom deliberately stays OUTSIDE this - see there.)
      document.addEventListener("astro:page-load", () => {
        const el = document.getElementById("today-indicator");
        if (el instanceof HTMLAnchorElement) {
          el.textContent = formatTodayLabel();
          // Kalender.vue reads ?day= to jump straight to that day's week view.
          const d = new Date();
          const iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
          el.href = `/kalender/?day=${iso}`;
        }

        // Light/dark/system toggle. "system" is the implicit default (no
        // localStorage entry, no data-theme attribute) - global.css's
        // prefers-color-scheme media query decides otherwise.
        const THEME_LABELS = {
          system: "System",
          light: "Hell",
          dark: "Dunkel",
        };
        const themeToggle = document.getElementById("theme-toggle");
        function currentTheme() {
          const t = localStorage.getItem("theme");
          return t === "light" || t === "dark" ? t : "system";
        }
        function renderThemeToggle() {
          const t = currentTheme();
          // Re-applied every navigation: a view transition's raw <html> never
          // carries data-theme, only client JS ever sets it.
          if (t === "system") delete document.documentElement.dataset.theme;
          else document.documentElement.dataset.theme = t;
          if (!themeToggle) return;
          // Icon-only now (see the 3 <Monitor|Sun|Moon> in the template above) -
          // toggle which one is visible instead of swapping text, and carry the
          // same state in aria-label since there's no visible text left for it.
          // A CSS class instead of the `hidden` attribute/IDL property - that
          // property's reflection onto SVG elements is inconsistent enough
          // across browsers that it silently left all three icons visible.
          themeToggle.setAttribute(
            "aria-label",
            `Farbschema: ${THEME_LABELS[t]}`,
          );
          for (const icon of themeToggle.querySelectorAll(
            "[data-theme-icon]",
          )) {
            icon.classList.toggle(
              "active",
              icon.getAttribute("data-theme-icon") === t,
            );
          }
        }
        renderThemeToggle();
        themeToggle?.addEventListener("click", () => {
          const order = ["system", "light", "dark"];
          const next =
            order[(order.indexOf(currentTheme()) + 1) % order.length];
          // renderThemeToggle() below applies data-theme itself now - only the
          // persisted preference is this handler's own job.
          if (next === "system") localStorage.removeItem("theme");
          else localStorage.setItem("theme", next);
          renderThemeToggle();
        });
      });

      // Cmd+K (Mac) / Ctrl+K (everyone else) jumps to the homepage search,
      // same target as the "Durchsuchen" nav link - focuses it directly if
      // we're already on "/", otherwise navigates there.
      //
      // Outside the astro:page-load block above ON PURPOSE: this binds to
      // `document`, which survives a view-transition swap. Re-binding it per
      // navigation would stack a duplicate handler every time. So this one
      // script block has two lifetimes - per-navigation above, once here.
      document.addEventListener("keydown", (e) => {
        if (e.key.toLowerCase() !== "k" || !(e.metaKey || e.ctrlKey)) return;
        e.preventDefault();
        const input = document.getElementById("search-input");
        if (input instanceof HTMLInputElement) {
          input.focus({ preventScroll: true });
          input.scrollIntoView({ block: "center", behavior: "smooth" });
        } else {
          window.location.href = "/#search-input";
        }
      });
    </script>
  </body>
</html>

<style>
  .wrap {
    max-width: 62rem;
    margin: 0 auto;
    padding-left: 1.75rem;
    padding-right: 1.75rem;
  }
  .wrap.wide {
    max-width: 88rem;
  }
  @media (max-width: 30rem) {
    .wrap {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  header {
    border-bottom: 1px solid var(--line);
  }
  .header-bar {
    padding-top: 1.1rem;
    padding-bottom: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem 1.5rem;
  }
  .brand {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--fs-md);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
  }
  .brand .brand-accent {
    color: var(--accent);
  }
  /* Everything else (size, weight, colour, padding, hover) comes from the
  `nav a` rule below - it sits in the nav now and should read like the two
  links beside it. Mono only because it's a date. */
  .today-indicator {
    font-variant-numeric: tabular-nums;
    min-width: 4.6rem;
  }
  nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.3rem 1.3rem;
    font-size: var(--fs-sm);
  }
  .nav-divider {
    width: 1px;
    height: 1em;
    background: var(--line);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--ink);
    text-decoration: none;
    padding: 0.3rem 0;
  }
  nav a:hover {
    color: var(--accent);
  }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem;
  }
  .theme-toggle [data-theme-icon] {
    display: none;
  }
  .theme-toggle [data-theme-icon].active {
    display: block;
  }

  main {
    padding-top: 2rem;
    padding-bottom: 3rem;
  }

  footer {
    margin-top: 3rem;
    border-top: 1px solid var(--line);
  }
  .footer-bar {
    padding-top: 1.25rem;
    padding-bottom: 2rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .footer-bar p {
    margin: 0 0 0.4rem;
  }
</style>
