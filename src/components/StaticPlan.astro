---
import { ArrowRight } from "@lucide/astro";
import { appliesTo } from "../../lib/facets";
import { byOffset, offsetLabel, sourceLabel } from "../../lib/offset-label";
import type { Deadline } from "../../lib/deadline-plan";

interface Props {
  deadlines: Deadline[];
  anchorLabel: string;
}
const { deadlines, anchorLabel } = Astro.props;

// One list, in the order things happen. Splitting it would make somebody hold
// two lists in their head and cross-reference them, which is worse than the
// mixture it was meant to tidy up.
const entries = deadlines.filter((d) => appliesTo(d, [])).sort(byOffset);
---

<!-- What the page is about, and what a crawler reads. Entering a date on it
turns every relative offset below into a day. -->
<section id="static-plan">
  <h2 class="t-section">Fristen und Quellen im Überblick</h2>
  <p class="lede t-body">
    Jede Frist relativ zum {anchorLabel}, mit der Quelle dahinter. Mit einem
    Datum wird oben daraus ein konkreter Tag.
  </p>
  <ol>
    {
      entries.map((d) => (
        <li>
          <p class="when t-meta">
            {d.kind === "soft" ? "Empfohlen: " : "Frist: "}
            {offsetLabel(d, anchorLabel)}
          </p>
          <div class="head">
            <h3 class="t-title">{d.label}</h3>
            <span class="marks">
              {d.needs_office && <span class="pill">Amtstermin</span>}
              {d.source_url && (
                <a class="pill source" href={d.source_url} rel="nofollow noopener">
                  {sourceLabel(d)}
                </a>
              )}
            </span>
          </div>
          {d.note && <p class="note t-body">{d.note}</p>}
          {d.kind !== "soft" && (
            <p class="src t-meta">
              <a class="frist go-link" href={`/frist/${d.id}/`}>
                Frist im Detail <ArrowRight size={14} />
              </a>
              {!d.source_url && (
                <span class:list={["flag", { missing: !d.no_source_needed }]}>
                  Grundlage: {sourceLabel(d)}
                </span>
              )}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</section>

<style>
  #static-plan {
    margin-top: var(--section-gap);
  }
  .lede {
    color: var(--muted);
    max-width: 52ch;
  }
  /* One container, one divider between rows. */
  ol {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--paper-raised);
    overflow: hidden;
  }
  li {
    padding: var(--s-2);
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  .when {
    color: var(--muted);
    margin: 0;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-1);
    margin: 0.15rem 0;
  }
  h3 {
    margin: 0;
  }
  /* Top right of the row, the same corner the plan puts them in. */
  .marks {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.3rem;
    margin-left: auto;
  }
  .pill.source {
    text-decoration: none;
  }
  .pill.source:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .note,
  .src {
    margin: 0.35rem 0 0;
  }
  .note {
    max-width: 68ch;
  }
  .src {
    color: var(--muted);
  }
  .flag.missing {
    color: var(--overdue);
  }
  /* The task has a page of its own, this list only summarises it. */
  .src .frist {
    margin-right: 0.6rem;
  }
</style>
