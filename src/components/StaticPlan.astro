---
import { appliesTo } from "../../lib/facets";
import { byOffset, offsetLabel, sourceLabel } from "../../lib/offset-label";
import type { Deadline } from "../../lib/deadline-plan";

interface Props {
  deadlines: Deadline[];
  anchorLabel: string;
}
const { deadlines, anchorLabel } = Astro.props;

const all = deadlines.filter((d) => appliesTo(d, []));
const entries = all.filter((d) => d.kind !== "soft").sort(byOffset);
// No date, so no place in a list sorted by date.
const soft = all.filter((d) => d.kind === "soft");
---

<!-- The fallback without JavaScript. The planner renders the same Fristen with
labels, notes and sources, so with JS this stays hidden. -->
<section id="static-plan" class="prehydrate">
  <h2>Fristen und Quellen im Überblick</h2>
  <p class="lede">
    Jede Frist relativ zum {anchorLabel}, mit der Quelle dahinter. Oben im
    Zeitplan wird daraus mit einem Datum ein konkreter Tag.
  </p>
  <ol>
    {
      entries.map((d) => (
        <li>
          <p class="when">{offsetLabel(d, anchorLabel)}</p>
          <h3>{d.label}</h3>
          {d.note && <p class="note">{d.note}</p>}
          <p class="src">
            {d.kind !== "soft" && (
              <a class="frist" href={`/frist/${d.id}/`}>
                Frist im Detail
              </a>
            )}
            {d.source_url ? (
              <a href={d.source_url} rel="nofollow noopener">
                {sourceLabel(d)}
              </a>
            ) : (
              <span class:list={["flag", { missing: !d.no_source_needed }]}>{sourceLabel(d)}</span>
            )}
          </p>
        </li>
      ))
    }
  </ol>
  {
    soft.length > 0 && (
      <>
        <h3 class="softhead">Ohne feste Frist</h3>
        <ul class="soft">
          {soft.map((d) => (
            <li>{d.label}</li>
          ))}
        </ul>
      </>
    )
  }
</section>

<style>
  #static-plan {
    margin-top: 2rem;
  }
  .lede {
    color: var(--muted);
    max-width: 52ch;
  }
  ol {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
  }
  li {
    padding: 1rem 0;
  }
  li + li {
    border-top: 1px solid var(--line);
  }
  .when {
    font-size: var(--t-meta);
    color: var(--muted);
    margin: 0;
  }
  h3 {
    font-size: var(--t-body);
    margin: 0.35rem 0;
  }
  .note,
  .src {
    font-size: var(--t-meta);
    margin: 0.35rem 0 0;
  }
  .note {
    color: var(--muted);
  }
  .flag.missing {
    color: var(--overdue);
  }
  /* The task has a page of its own, this list only summarises it. */
  .src .frist {
    margin-right: 0.6rem;
  }
  .softhead {
    margin-top: 1.5rem;
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .soft {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--muted);
    font-size: var(--t-meta);
  }
</style>
