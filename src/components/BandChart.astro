---
// Static, zero-JS rolling day-window x scope table (the schulferien.org
// shape) - unlike YearGrid this is real, accessible table markup, not a
// decorative overlay: on a category page like /schulferien/ there is no
// existing dated list to fall back to, so this table IS the accessible
// content, not a duplicate of one.
import type { BandChart } from "../../lib/band-chart";
import { toDate } from "../../lib/format-date";

interface Props {
  chart: BandChart;
  primaryLabel: string;
  accentLabel?: string;
}
const { chart, primaryLabel, accentLabel } = Astro.props;

function longDate(iso: string): string {
  return toDate(iso).toLocaleDateString("de-DE", { day: "2-digit", month: "2-digit", year: "numeric", timeZone: "UTC" });
}
---

<div class="table-wrap band-chart">
  <table>
    <caption class="sr-only">
      {chart.rows.length} Reihen vom {longDate(chart.days[0].iso)} bis {longDate(chart.days.at(-1)!.iso)}.
    </caption>
    <thead>
      <tr>
        <th scope="col" class="corner" />
        {chart.months.map((m) => <th scope="col" colspan={m.days} class="month-header">{m.label}</th>)}
      </tr>
      <tr>
        <th scope="col" class="corner" />
        {
          chart.days.map((d) => (
            <th scope="col" class:list={["day-header", { weekend: d.weekend, today: d.today }]}>
              <span class="dow">{d.weekday}</span>
              <span class="dom">{String(d.dayOfMonth).padStart(2, "0")}</span>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        chart.rows.map((row) => (
          <tr>
            <th scope="row">
              <a href={row.href}>{row.label}</a>
            </th>
            {row.cells.map((cell, i) => (
              <td class:list={["cell", cell.state, { today: chart.days[i].today }]}>
                {(cell.state === "primary" || cell.state === "accent") && (
                  <a href={`/kalender/?day=${cell.iso}&layers=${row.layerId}`}>
                    <span class="sr-only">
                      {cell.title} ({longDate(cell.iso)})
                    </span>
                  </a>
                )}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
<p class="legend">
  <span class="swatch primary" /> {primaryLabel}
  {
    accentLabel && (
      <>
        <span class="swatch accent" /> {accentLabel}
      </>
    )
  }
  <span class="swatch weekend" /> Wochenende
</p>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .band-chart table {
    font-size: 0.72rem;
    border-collapse: separate;
    border-spacing: 1px;
  }
  .band-chart th,
  .band-chart td {
    padding: 0;
    border: none;
    white-space: nowrap;
  }
  .band-chart .corner {
    position: sticky;
    left: 0;
    background: var(--paper);
    z-index: 2;
  }
  .band-chart th[scope="row"] {
    position: sticky;
    left: 0;
    background: var(--paper);
    text-align: left;
    padding: 0.15rem 0.6rem 0.15rem 0;
    font-weight: 500;
    font-size: 0.78rem;
    color: var(--ink);
    text-transform: none;
    letter-spacing: normal;
  }
  .band-chart th[scope="row"] a {
    color: inherit;
    text-decoration: none;
  }
  .band-chart th[scope="row"] a:hover {
    color: var(--accent);
  }
  .month-header {
    text-align: left;
    color: var(--muted);
    font-size: 0.72rem;
    padding: 0 0 0.2rem 0.1rem;
  }
  .day-header {
    width: 1.4rem;
    min-width: 1.4rem;
    text-align: center;
    color: var(--muted);
    font-weight: 400;
    line-height: 1.1;
  }
  .day-header .dow {
    display: block;
    font-size: 0.62rem;
  }
  .day-header .dom {
    display: block;
    font-variant-numeric: tabular-nums;
  }
  .day-header.weekend {
    color: var(--ink);
  }
  .day-header.today {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
    border-radius: 2px;
  }
  .cell {
    width: 1.4rem;
    height: 1.1rem;
    border-radius: 2px;
    background: var(--paper-raised);
  }
  .cell.weekend {
    background: var(--line);
  }
  .cell.primary {
    /* Same accent hue as everywhere else on the site (see PlannerView.vue's
    own color-mix use), just diluted - one palette, two intensities: a soft
    wash for the common state, full accent for the exception. */
    background: color-mix(in srgb, var(--accent) 40%, var(--paper-raised));
  }
  .cell.accent {
    background: var(--accent);
  }
  .cell.today {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }
  .cell a {
    display: block;
    width: 100%;
    height: 100%;
  }
  .band-chart tbody tr:hover th[scope="row"] {
    background: var(--paper-raised);
  }
  .band-chart tbody tr:hover td.plain,
  .band-chart tbody tr:hover td.weekend {
    background: var(--line);
  }
  .band-chart tbody tr:hover td.primary,
  .band-chart tbody tr:hover td.accent {
    filter: brightness(1.15);
  }
  .legend {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.6rem 0 2rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .swatch {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    background: var(--accent);
  }
  .swatch.primary {
    background: color-mix(in srgb, var(--accent) 40%, var(--paper-raised));
  }
  .swatch.weekend {
    background: var(--line);
  }
  .swatch:not(:first-child) {
    margin-left: 0.8rem;
  }
</style>
