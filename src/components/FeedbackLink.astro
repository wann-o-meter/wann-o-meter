---
import { ArrowRight } from "@lucide/astro";
---

<p class="feedback">
  <a class="go-link" href="/feedback/">
    Fehler gefunden? Schreib uns <ArrowRight size={14} />
  </a>
</p>

<style>
  .feedback {
    margin: var(--s-3) 0 0;
    font-size: var(--t-meta);
  }

  @media print {
    .feedback {
      display: none;
    }
  }
</style>
