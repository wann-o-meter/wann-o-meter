---
// Static, zero-JS holiday x Bundesland table. Reuses the site's default
// table/.table-wrap styling (src/styles/global.css) - only the sticky first
// column and the "not observed" dot are specific to this component.
import type { ScopeMatrix } from "../../lib/scope-matrix";
import { toDate } from "../../lib/format-date";

interface Props {
  year: number;
  matrix: ScopeMatrix;
}
const { year, matrix } = Astro.props;
const { scopes, rows } = matrix;

function dayMonth(iso: string): string {
  return toDate(iso).toLocaleDateString("de-DE", { day: "2-digit", month: "2-digit", timeZone: "UTC" });
}
---

<div class="table-wrap scope-matrix">
  <table>
    <caption class="sr-only">Feiertage {year} nach Bundesland, mit Datum je Bundesland.</caption>
    <thead>
      <tr>
        <th scope="col">Feiertag</th>
        {
          scopes.map((s) => (
            <th scope="col">
              <a href={s.href} title={s.name}>{s.label}</a>
            </th>
          ))
        }
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <th scope="row">{row.title}</th>
            {scopes.map((s) => {
              const date = row.dateByScope[s.code];
              return (
                <td>
                  {date ? (
                    <a href={`/kalender/?day=${date}&layers=${s.layerId}`}>{dayMonth(date)}</a>
                  ) : (
                    <span class="none" aria-hidden="true">·</span>
                  )}
                </td>
              );
            })}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .scope-matrix th[scope="row"] {
    position: sticky;
    left: 0;
    background: var(--paper);
    text-transform: none;
    font-size: 0.85rem;
    color: var(--ink);
  }
  .scope-matrix .none {
    color: var(--muted);
  }
</style>
