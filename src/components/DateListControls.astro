---
// Year navigation + newest/oldest sort toggle for a dated list or table on a
// subject detail page (src/pages/[...path].astro renders it on both the
// evergreen page and its year pages). Expects the page to wrap its rows/
// table-body in id="year-rows" - works for both <li> and <tr>, since the
// script only ever queries by id, not tag.
//
// Every pill is a LINK to a prerendered year page (lib/year-pages.ts generates
// one for every year a page has data for, uncapped). It used to be able to
// filter the list in place instead, which meant one control with two
// behaviours depending on the page - whether a year happens to be prerendered
// is not something a visitor should be able to feel. Prefetched and swapped
// via view transitions (Layout.astro), so following one of these reads like a
// filter updating rather than a page load.
import { inIndexWindow } from "../../lib/year-pages";

interface Props {
  yearLinks: { year: number; href: string }[];
  category: string; // decides which years are indexable, see lib/year-pages.ts
  allHref?: string; // set on a year page: back to the evergreen "all years" page
  currentYear?: number; // the year page we're ON - rendered active, not as a link
}
const { yearLinks, category, allHref, currentYear } = Astro.props;

// Only the INDEXABLE years get a pill, i.e. an <a>. data/astronomie/
// sonnenfinsternis spans 1901-2100, and linking all 200 from every page spends
// the site's internal link weight on years nobody searches for - the same
// years that are noindex anyway. The rest stay one keystroke away in the
// <select> below, which navigates by JS and is not a link at all, so the
// archive costs nothing in the link graph. The year page we are ON is always
// a pill: it is the active state, and a control that hides the current item is
// just confusing.
const pills = yearLinks.filter((l) => l.year === currentYear || inIndexWindow(category, l.year));
const hasArchive = pills.length < yearLinks.length;
---

{
  /* Renders even for a single year: that lone year page is only reachable
     from here, so a "one year needs no picker" gate would orphan it. */
  yearLinks.length > 0 && (
    <div class="year-filter">
      <p class="year-pills">
        {allHref ? (
          <a class="year-btn" href={allHref} data-astro-prefetch="viewport">Alle</a>
        ) : (
          /* On the evergreen page "Alle" IS this page - the current item, not
             somewhere to navigate to. */
          <span class="year-btn active" aria-current="page">Alle</span>
        )}
        {pills.map((l) =>
          l.year === currentYear ? (
            <span class="year-btn active" aria-current="page">{l.year}</span>
          ) : (
            <a class="year-btn" href={l.href} data-astro-prefetch="viewport">
              {l.year}
            </a>
          ),
        )}
      </p>

      {hasArchive && (
        <p class="year-jump">
          <label for="year-select">Weiteres Jahr wählen</label>
          {/* The option's value IS the destination, so this jumps to a year
              page the same way the pills do. */}
          <select id="year-select">
            <option value={allHref ?? ""}>Alle {yearLinks.length} Jahre</option>
            {yearLinks.map((l) => (
              <option value={l.href} selected={l.year === currentYear}>{l.year}</option>
            ))}
          </select>
        </p>
      )}
    </div>
  )
}

<p class="sort-toggle">
  <button type="button" id="sort-toggle" class="year-btn">↓ Neueste zuerst</button>
</p>

<script>
  // Re-run per navigation: <ClientRouter /> (Layout.astro) swaps the body, so
  // the pills and rows this binds to are replaced on every year change and a
  // once-only module script would leave the sort toggle dead. Fires on the
  // initial load too, so nothing changes for a plain visit.
  document.addEventListener("astro:page-load", () => {
    const yearSelect = document.getElementById("year-select") as HTMLSelectElement | null;
    yearSelect?.addEventListener("change", () => {
      if (yearSelect.value) window.location.href = yearSelect.value;
    });

    // Rows are pre-sorted ascending at build time - "sorting" is just
    // reversing DOM order, no comparator needed.
    const sortToggle = document.getElementById("sort-toggle");
    const container = document.getElementById("year-rows");
    let descending = false;
    sortToggle?.addEventListener("click", () => {
      descending = !descending;
      sortToggle.textContent = descending ? "↑ Älteste zuerst" : "↓ Neueste zuerst";
      container?.append(...[...container.children].reverse());
    });
  });
</script>

<style>
  .sort-toggle {
    margin: 0 0 1rem;
  }
  .year-filter {
    margin: 1rem 0;
  }
  .year-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }
  .year-jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .year-jump select {
    font-size: 0.82rem;
  }
  /* One rule for all three pill elements (<a>, <span>, <button>), so a year
     pill looks the same whether it links, marks the current page, or sorts. */
  .year-btn {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--muted);
  }
  .year-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .year-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
</style>
