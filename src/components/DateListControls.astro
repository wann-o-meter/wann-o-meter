---
// Year navigation + newest/oldest sort toggle for a dated list or table on a
// subject detail page (src/pages/[...path].astro renders it on both the
// evergreen page and its year pages). Expects the page to wrap its rows/
// table-body in id="year-rows" - works for both <li> and <tr>, since the
// script only ever queries by id, not tag.
//
// Every pill is a LINK to a prerendered year page (lib/year-pages.ts generates
// one for every year a page has data for, uncapped). It used to be able to
// filter the list in place instead, which meant one control with two
// behaviours depending on the page - whether a year happens to be prerendered
// is not something a visitor should be able to feel. Prefetched and swapped
// via view transitions (Layout.astro), so following one of these reads like a
// filter updating rather than a page load.
import { inIndexWindow } from "../../lib/year-pages";

interface Props {
  yearLinks: { year: number; href: string }[];
  category: string; // decides which years are indexable, see lib/year-pages.ts
  allHref?: string; // set on a year page: back to the evergreen "all years" page
  currentYear?: number; // the year page we're ON - rendered active, not as a link
}
const { yearLinks, category, allHref, currentYear } = Astro.props;

// Only the INDEXABLE years get a pill up front. data/astronomie/
// sonnenfinsternis spans 1901-2100, and linking all 200 from every page spends
// the site's internal link weight on years nobody searches for - the same
// years that are noindex anyway. The rest sit in a <template> and are revealed
// by the two buttons: a template's content is NOT in the document until it is
// cloned, so those <a>s exist for a visitor who asks for them and for nobody
// else. (`hidden` or `display:none` would not do - a crawler renders the page
// and follows hidden links just the same.) The year page we are ON is always a
// pill: it is the active state, and a control that hides the current item is
// just confusing.
const shown = (l: { year: number }) => l.year === currentYear || inIndexWindow(category, l.year);
const pills = yearLinks.filter(shown);
const first = pills[0]?.year ?? Infinity;
const last = pills[pills.length - 1]?.year ?? -Infinity;
const past = yearLinks.filter((l) => !shown(l) && l.year < first);
const future = yearLinks.filter((l) => !shown(l) && l.year > last);
const hasHidden = past.length + future.length > 0;
---

{
  /* Renders even for a single year: that lone year page is only reachable
     from here, so a "one year needs no picker" gate would orphan it. */
  yearLinks.length > 0 && (
    <div class="year-filter">
      <p class="year-pills">
        {past.length > 0 && (
          <button type="button" class="year-btn year-reveal" data-reveal="past">Vergangene Jahre anzeigen</button>
        )}
        {allHref ? (
          <a class="year-btn" href={allHref} data-astro-prefetch="viewport">Alle</a>
        ) : (
          /* On the evergreen page "Alle" IS this page - the current item, not
             somewhere to navigate to. */
          <span class="year-btn active" aria-current="page">Alle</span>
        )}
        {/* rel="nofollow" for the moment they ARE in the document, after a
            click: a hint rather than a rule since 2019, but it costs one
            attribute and says what we mean. What actually keeps these years out
            of the index is their own noindex (lib/year-pages.ts) - a robots.txt
            Disallow would be worse than nothing, because a URL Google may not
            fetch is a URL whose noindex it can never read. No prefetch either:
            revealing years should not fire a page fetch per pill. */}
        {past.length > 0 && (
          <template data-years="past">{past.map((l) => <a class="year-btn" rel="nofollow" href={l.href}>{l.year}</a>)}</template>
        )}
        {pills.map((l) =>
          l.year === currentYear ? (
            <span class="year-btn active" aria-current="page">{l.year}</span>
          ) : (
            <a class="year-btn" href={l.href} data-astro-prefetch="viewport">
              {l.year}
            </a>
          ),
        )}
        {future.length > 0 && (
          <template data-years="future">{future.map((l) => <a class="year-btn" rel="nofollow" href={l.href}>{l.year}</a>)}</template>
        )}
        {future.length > 0 && (
          <button type="button" class="year-btn year-reveal" data-reveal="future">Mehr anzeigen</button>
        )}
      </p>

      {hasHidden && (
        <p class="year-jump">
          <label for="year-select">Jahr direkt wählen</label>
          {/* Stepping through 200 years five at a time is fine for browsing and
              useless for "take me to 1954", which is what this is for. An
              <option> is not a link, so listing every year here costs nothing
              in the link graph - that is why the reveal buttons above exist
              instead of a plain pill row, and why this select can stay
              complete. */}
          <select id="year-select">
            <option value={allHref ?? ""}>Alle {yearLinks.length} Jahre</option>
            {yearLinks.map((l) => (
              <option value={l.href} selected={l.year === currentYear}>{l.year}</option>
            ))}
          </select>
        </p>
      )}
    </div>
  )
}

<p class="sort-toggle">
  <button type="button" id="sort-toggle" class="year-btn">↓ Neueste zuerst</button>
</p>

<script>
  // Re-run per navigation: <ClientRouter /> (Layout.astro) swaps the body, so
  // the pills and rows this binds to are replaced on every year change and a
  // once-only module script would leave the sort toggle dead. Fires on the
  // initial load too, so nothing changes for a plain visit.
  document.addEventListener("astro:page-load", () => {
    // A click hands out the next STEP years from the button's own <template>,
    // nearest first - the past list ends where the visible pills begin, the
    // future one starts there. Inserting before the template needs no anchor of
    // its own: the template already sits exactly where its years belong.
    // Emptied, the button has nothing left to do and goes.
    const STEP = 5;
    const filter = document.querySelector(".year-filter");
    for (const button of filter?.querySelectorAll<HTMLButtonElement>("[data-reveal]") ?? []) {
      const template = filter?.querySelector<HTMLTemplateElement>(
        `template[data-years="${button.dataset.reveal}"]`,
      );
      button.addEventListener("click", () => {
        if (!template) return;
        const years = [...template.content.children];
        template.before(...(button.dataset.reveal === "past" ? years.slice(-STEP) : years.slice(0, STEP)));
        if (template.content.children.length === 0) button.remove();
      });
    }

    const yearSelect = document.getElementById("year-select") as HTMLSelectElement | null;
    yearSelect?.addEventListener("change", () => {
      if (yearSelect.value) window.location.href = yearSelect.value;
    });

    // Rows are pre-sorted ascending at build time - "sorting" is just
    // reversing DOM order, no comparator needed.
    const sortToggle = document.getElementById("sort-toggle");
    const container = document.getElementById("year-rows");
    let descending = false;
    sortToggle?.addEventListener("click", () => {
      descending = !descending;
      sortToggle.textContent = descending ? "↑ Älteste zuerst" : "↓ Neueste zuerst";
      container?.append(...[...container.children].reverse());
    });
  });
</script>

<style>
  .sort-toggle {
    margin: 0 0 1rem;
  }
  .year-filter {
    margin: 1rem 0;
  }
  .year-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
  }
  .year-jump {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
  }
  .year-jump select {
    font-size: 0.82rem;
  }
  /* One rule for all three pill elements (<a>, <span>, <button>), so a year
     pill looks the same whether it links, marks the current page, or sorts. */
  .year-btn {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--muted);
  }
  .year-btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
  .year-btn.active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }
  .year-reveal {
    border-style: dashed;
  }
</style>
