---
import Layout from "../../layouts/Layout.astro";
import DeadlinePlanner from "../../components/DeadlinePlanner.vue";
import type { PlanVariant } from "../../components/DeadlinePlanner.vue";
import { loadAllUmzugKommunen } from "../../../lib/umzug-data";

const variants: PlanVariant[] = loadAllUmzugKommunen().map((k) => ({
  slug: k.slug,
  label: k.name,
  regionCode: k.state,
  deadlines: k.deadlines,
}));
---

<Layout
  title="Umzug: wann muss ich anfangen?"
  description="Ort und Umzugstag eingeben, kompletten Rückwärts-Zeitplan mit Fristen sehen - mit Wochenend- und Feiertagswarnung."
>
  <p class="back"><a href="/">&larr; Alle Vorhaben</a></p>
  <h1>Umzug: wann muss ich anfangen?</h1>
  <DeadlinePlanner
    client:only="vue"
    vorhaben="Umzug innerhalb Deutschlands"
    anchorLabel="Umzugstag"
    variantLabel="Ort"
    variants={variants}
    defaultSlug="rottenburg"
  />
</Layout>

<style>
  .back {
    font-size: 0.9rem;
  }
  h1 {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
</style>
