---
import Layout from "../layouts/Layout.astro";
import IndexTimeline from "../components/Index.vue";
import { loadAllVorhaben } from "../../lib/vorhaben-data";
import { allFristTasks } from "../../lib/tasks";
import FristenFinder from "../components/FristenFinder.vue";

const homeDescription =
  "Wann muss ich anfangen? Fristen rückwärts vom Termin geplant, mit Quelle - Umzug, Geburt, Hochzeit und Jobwechsel.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Wann-O-Meter",
  url: new URL("/", Astro.site).href,
  description: homeDescription,
};

const vorhaben = loadAllVorhaben();

// Every Frist with a paragraph behind it has its own page. Those pages answer
// the question people actually type, so they get a section that both a crawler
// and a searching visitor can work with.
const fristen = allFristTasks().map(({ task, vorhaben }) => ({
  id: task.id,
  label: task.label,
  source: task.source_label ?? "Quelle",
  tags: task.tags,
  note: task.note,
  plans: vorhaben.map((v) => ({ slug: v.slug, label: v.label })),
}));

---

<Layout title="Wann muss ich anfangen?" description={homeDescription} structuredData={structuredData}>
  <IndexTimeline client:load vorhaben={vorhaben} />

  <FristenFinder client:load fristen={fristen} />
</Layout>
