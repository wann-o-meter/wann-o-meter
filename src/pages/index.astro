---
import Layout from "../layouts/Layout.astro";
import IndexTimeline from "../components/Index.vue";
import { getPagesInCategory } from "../../lib/pages";
import { loadAllVorhaben } from "../../lib/vorhaben-data";

const homeDescription =
  "Wann muss ich anfangen? Fristen rückwärts vom Termin geplant, mit Quelle - Umzug, Geburt, Hochzeit und Jobwechsel.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Wann-O-Meter",
  url: new URL("/", Astro.site).href,
  description: homeDescription,
};

const vorhaben = loadAllVorhaben();

// Schulferien of every Bundesland, trimmed to the range the date picker allows,
// so the picked Termin can be checked against them in the browser.
const ISO_DAY = /^\d{4}-\d{2}-\d{2}$/;
const today = new Date().toISOString().slice(0, 10);
const horizon = new Date(Date.now() + 400 * 86400000).toISOString().slice(0, 10);
const schulferien = Object.fromEntries(
  getPagesInCategory("schulferien").map((page) => [
    page.slug.toUpperCase(),
    page.data.windows
      .filter(
        (w) =>
          ISO_DAY.test(w.from) &&
          ISO_DAY.test(w.to) &&
          w.to >= today &&
          w.from <= horizon,
      )
      .map((w) => ({ from: w.from, to: w.to, name: w.name ?? "Schulferien" })),
  ]),
);
---

<Layout title="Wann muss ich anfangen?" description={homeDescription} structuredData={structuredData}>
  <!-- idle, not load: the page is server rendered, so let it paint before the
  island and its holiday tables take the main thread. -->
  <IndexTimeline client:idle vorhaben={vorhaben} schulferien={schulferien} />

  <!-- The picker above is a set of buttons, this is the crawlable way in. -->
  <section class="all-plans">
    <h2>Alle Zeitpläne</h2>
    <ul>
      {
        vorhaben.map((v) => (
          <li>
            <h3><a href={`/${v.slug}/`}>{v.label}: wann muss ich anfangen?</a></h3>
            <p>{v.description}</p>
            {v.variants.length > 1 && (
              <p class="places">
                Mit örtlichen Fristen:{" "}
                {v.variants
                  .filter((s) => s.slug !== "bundesweit")
                  .map((s, i) => (
                    <>
                      {i > 0 && <span aria-hidden="true"> &middot; </span>}
                      <a href={`/${v.slug}/${s.slug}/`}>
                        {v.label} in {s.label}
                      </a>
                    </>
                  ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  .all-plans {
    margin-top: 4rem;
  }
  .all-plans ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }
  .all-plans h3 {
    margin: 0 0 0.25rem;
    font-size: var(--fs-md);
  }
  .all-plans p {
    margin: 0;
    color: var(--muted);
    font-size: var(--fs-sm);
    max-width: 60ch;
  }
  .all-plans .places {
    margin-top: 0.25rem;
  }
</style>
