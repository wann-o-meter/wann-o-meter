---
import Layout from "../layouts/Layout.astro";
import IndexTimeline from "../components/Index.vue";
import { graph, websiteNode } from "../../lib/structured-data";
import { loadAllUmzugKommunen } from "../../lib/umzug-data";

const homeDescription =
  "Wann muss ich anfangen? Fristen rückwärts vom Termin geplant, mit Quelle - Umzug zuerst, weitere Lebensereignisse folgen.";
const structuredData = graph([
  websiteNode({ name: "Wann-O-Meter", url: new URL("/", Astro.site).href, description: homeDescription }),
]);

// Same variant list and default Kommune as /umzug/'s DeadlinePlanner - the
// homepage mounts that same component in place once a date is picked, not a
// second data source or a second planner UI.
const variants = loadAllUmzugKommunen().map((k) => ({
  slug: k.slug,
  label: k.name,
  regionCode: k.state,
  deadlines: k.deadlines,
}));
---

<Layout title="Wann muss ich anfangen?" description={homeDescription} structuredData={structuredData}>
  <IndexTimeline client:load variants={variants} defaultSlug="rottenburg" />
</Layout>
