---
import FadeInText from "@astroanimate/core/FadeInText";
import Layout from "../layouts/Layout.astro";
import IndexTimeline from "../components/Index.vue";
import { loadAllVorhaben } from "../../lib/vorhaben-data";
import { allFristTasks } from "../../lib/tasks";
import FristenFinder from "../components/FristenFinder.vue";

const homeDescription =
  "Plane mit Datum statt Checkliste: Termin eingeben, jede Aufgabe als konkretes Datum. Für Umzug, Geburt, Hochzeit und Jobwechsel.";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Wann-O-Meter",
  url: new URL("/", Astro.site).href,
  description: homeDescription,
};

const vorhaben = loadAllVorhaben();

// Every Frist with a paragraph behind it has its own page. Those pages answer
// the question people actually type, so they get a section that both a crawler
// and a searching visitor can work with.
const fristen = allFristTasks().map(({ task, vorhaben }) => ({
  id: task.id,
  label: task.label,
  source: task.source_label ?? "Quelle",
  tags: task.tags,
  note: task.note,
  plans: vorhaben.map((v) => ({ slug: v.slug, label: v.label })),
}));
---

<Layout
  title="Plane mit Datum statt Checkliste"
  description={homeDescription}
  structuredData={structuredData}
>
  <!-- One after the other on arrival: the promise, then what it means, then
  the things to do about it. -->
  <section class="intro">
    <FadeInText>
      <h1>Damit dir keine Frist durchrutscht.</h1>
    </FadeInText>
    <FadeInText delay={0.14}>
      <p class="lede t-body">
        Wann-O-Meter macht aus deinem Termin ein Datum je Aufgabe: bis wann sie
        erledigt sein muss, <strong>mit Paragraf</strong>, und mit den
        Feiertagen deines Bundeslands schon eingerechnet.
      </p>
    </FadeInText>
  </section>

  <FadeInText delay={0.28}>
    <IndexTimeline client:load vorhaben={vorhaben} />
  </FadeInText>

  <FadeInText delay={0.42}>
    <FristenFinder
      client:load
      fristen={fristen}
      plans={vorhaben.map((v) => ({ slug: v.slug, label: v.label }))}
    />
  </FadeInText>
</Layout>

<style>
  /* Reached from inside the site: the page is simply there. */
  html[data-visited] [data-astro-fade-in-text] {
    opacity: 1 !important;
    filter: none !important;
    transform: none !important;
    animation: none !important;
    transition: none !important;
  }
  .intro {
    padding: var(--s-2) 0 var(--s-1);
  }
  .intro h1 {
    max-width: 20ch;
    margin: 0 0 var(--s-2);
  }
  .lede {
    color: var(--muted);
    max-width: 56ch;
    margin: 0;
  }
  .lede strong {
    color: var(--ink);
  }
</style>
