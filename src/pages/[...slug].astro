---
import Layout from "../layouts/Layout.astro";
import DeadlinePlanner from "../components/DeadlinePlanner.vue";
import StaticPlan from "../components/StaticPlan.astro";
import { vorhabenRoutes } from "../../lib/vorhaben-routes";

export function getStaticPaths() {
  return vorhabenRoutes().map((r) => ({ params: { slug: r.path }, props: r }));
}

const { v, variant, title, description } = Astro.props;
// Only worth linking where there is more than one place to go.
const siblings = v.variants.length > 1 ? v.variants : [];
---

<Layout title={title} description={description}>
  <p class="back"><a href="/">&larr; Alle Vorhaben</a></p>
  <h1>{title}</h1>
  <DeadlinePlanner
    client:only="vue"
    vorhaben={v.vorhaben}
    anchorLabel={v.anchorLabel}
    variantLabel={v.variantLabel}
    variants={v.variants}
    defaultSlug={variant.slug}
  />
  <StaticPlan deadlines={variant.deadlines} anchorLabel={v.anchorLabel} />
  {
    siblings.length > 0 && (
      <nav class="places">
        <h2>{v.label} in deiner Stadt</h2>
        <ul>
          {siblings.map((s) => (
            <li>
              <a
                href={`/${v.slug}/${s.slug}/`}
                aria-current={s.slug === variant.slug ? "page" : undefined}
              >
                {v.label} in {s.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )
  }
</Layout>

<style>
  .back {
    font-size: 0.9rem;
  }
  h1 {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .places {
    margin-top: 2.5rem;
  }
  .places ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .places a {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.4rem 0.9rem;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .places a[aria-current="page"] {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
