---
import Layout from "../layouts/Layout.astro";
import PlanWizard from "../components/PlanWizard.vue";
import StaticPlan from "../components/StaticPlan.astro";
import { vorhabenRoutes } from "../../lib/vorhaben-routes";
import { BUNDESWEIT_SLUG } from "../../lib/vorhaben-data";
import { appliesTo } from "../../lib/facets";
import { byOffset, offsetLabel } from "../../lib/offset-label";

export function getStaticPaths() {
  return vorhabenRoutes().map((r) => ({ params: { slug: r.path }, props: r }));
}

const { v, variant, title, heading, description, noindex } = Astro.props;
const isPlace = Astro.params.slug !== v.slug;
const crumbs = [
  { name: "Startseite", url: new URL("/", Astro.site).href },
  { name: v.label, url: new URL(`/${v.slug}/`, Astro.site).href },
  ...(isPlace
    ? [
      {
        name: variant.label,
        url: new URL(`/${v.slug}/${variant.slug}/`, Astro.site).href,
      },
    ]
    : []),
];
// Every number below is counted from the plan itself, so the text cannot drift
// away from the Fristen it describes.
const entries = variant.deadlines.filter((d) => appliesTo(d, [])).sort(byOffset);
const fristen = entries.filter((d) => d.kind !== "soft");
const softCount = entries.length - fristen.length;
const first = entries[0];
const officeSteps = entries.filter((d) => d.needs_office).map((d) => d.label);
// Only worth a sentence where it splits the Fristen. All of them or none of
// them is what the plan's direction already says.
const after = fristen.filter((d) => (d.offset_days ?? 0) > 0).length;
const afterAnchor = after === fristen.length ? 0 : after;
const fristCount = (n: number) => `${n} ${n === 1 ? "Frist" : "Fristen"}`;
const baseIds = new Set(
  (v.variants.find((x) => x.slug === BUNDESWEIT_SLUG)?.deadlines ?? []).map(
    (d) => d.id,
  ),
);
const localSteps = entries
  .filter((d) => !baseIds.has(d.id))
  .map((d) => d.label.split(" ")[0]);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "ItemList",
      name: title,
      description,
      numberOfItems: entries.length,
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      itemListElement: entries.map((d, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: d.label,
      })),
    },
  ],
};
const siblings = v.variants.filter((s) => s.slug !== BUNDESWEIT_SLUG);
const PREVIEW = 12;
const preview = siblings.slice(0, PREVIEW);
const rest = siblings.slice(PREVIEW);
---

<Layout
  title={title}
  description={description}
  structuredData={structuredData}
  noindex={noindex}
>
  <p class="back"><a href="/">&larr; Alle Vorhaben</a></p>
  <h1>{heading}</h1>
  <!-- Keep in sync with the .overview paragraph in DeadlinePlanner.vue, which
  recounts the same sentences once the Ort or the facets change. -->
  <p class="overview t-body">
    Der Zeitplan für {v.vorhaben} umfasst{" "}
    {fristen.length > 0 ? (
      <>
        <b>{fristCount(fristen.length)}</b>
        {softCount > 0 && <> und {softCount} weitere Schritte</>}
      </>
    ) : (
      <><b>{entries.length} Schritte</b> ohne gesetzliche Frist</>
    )}.{" "}
    {first && (
      <>
        Es geht los mit {first.label} ({offsetLabel(first, v.anchorLabel)}).{" "}
      </>
    )}
    {afterAnchor > 0 && (
      <>{fristCount(afterAnchor)} laufen erst nach dem {v.anchorLabel}.{" "}</>
    )}
    {officeSteps.length > 0 && (
      <>
        Termine beim Amt sind je nach Stadt Wochen im Voraus vergeben
        ({officeSteps.join(", ")}).{" "}
      </>
    )}
    {localSteps.length > 0 && (
      <>In {variant.label} kommen dazu: {localSteps.join(", ")}.</>
    )}
  </p>
  <!-- Holds the height the wizard will take, so the page below it does not
  jump when the island renders. -->
  <div class="planner-slot">
    <PlanWizard
      client:only="vue"
      slug={v.slug}
      vorhaben={v.vorhaben}
      anchorLabel={v.anchorLabel}
      variantLabel={v.variantLabel}
      variantPreposition={v.variantPreposition}
      variants={v.variants}
      defaultSlug={variant.slug}
    />
  </div>
  <StaticPlan
    deadlines={variant.deadlines}
    anchorLabel={v.anchorLabel}
  />
  {
    siblings.length > 0 && (
      <nav class="places">
        <h2>Örtliche Fristen</h2>
        <p class="places-note">
          Halteverbotszone, Anwohnerparkausweis und Sperrmüll regelt jede
          Kommune in ihrer eigenen Satzung, bundesweit gibt es dafür keine
          Frist. Für diese Orte haben wir sie nachgeschlagen:
        </p>
        <ul>
          {preview.map((s) =>
            s.slug === variant.slug ? (
              <li>
                <span class="here" aria-current="page">
                  {v.label} in {s.label}
                </span>
              </li>
            ) : (
              <li>
                <a href={`/${v.slug}/${s.slug}/`}>
                  {v.label} in {s.label}
                </a>
              </li>
            ),
          )}
        </ul>
        {rest.length > 0 && (
          <details>
            <summary>Alle {siblings.length} Orte</summary>
            <ul>
              {rest.map((s) => (
                <li>
                  <a
                    href={`/${v.slug}/${s.slug}/`}
                    aria-current={s.slug === variant.slug ? "page" : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </nav>
    )
  }
</Layout>

<style>
  .overview {
    max-width: 62ch;
    color: var(--muted);
  }
  .overview b {
    color: var(--ink);
    font-weight: var(--fw-semibold);
  }
  .back {
    font-size: var(--t-meta);
  }
  /* ponytail: one number for every plan, split it per Vorhaben if the plans
  ever differ enough in length that the reserve reads as empty space. */
  html[data-js] .planner-slot {
    min-height: 20rem;
  }
  h1 {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
  }
  .places {
    margin-top: 2rem;
  }
  .places-note {
    max-width: 62ch;
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .places ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
  }
  /* Links, not chips: the chip shape belongs to a choice you make here. */
  .places a,
  .places .here {
    font-size: var(--t-meta);
  }
  .places .here {
    color: var(--muted);
  }
  .places details {
    margin-top: 0.75rem;
    font-size: var(--t-meta);
  }
  .places summary {
    cursor: pointer;
    color: var(--muted);
  }
  .places details ul {
    margin-top: 0.5rem;
  }

  @media print {
    .back,
    .places {
      display: none;
    }
  }
</style>
