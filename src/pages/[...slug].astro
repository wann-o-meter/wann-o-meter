---
import Layout from "../layouts/Layout.astro";
import DeadlinePlanner from "../components/DeadlinePlanner.vue";
import StaticPlan from "../components/StaticPlan.astro";
import { vorhabenRoutes } from "../../lib/vorhaben-routes";

export function getStaticPaths() {
  return vorhabenRoutes().map((r) => ({ params: { slug: r.path }, props: r }));
}

const { v, variant, title, description } = Astro.props;
// Only worth linking where there is more than one place to go.
const siblings = v.variants.length > 1 ? v.variants : [];
// A pill per Kommune stops being a nav once there are hundreds of them. The
// rest stay in the HTML inside a <details>, so they are still crawlable.
const PREVIEW = 12;
const preview = siblings.slice(0, PREVIEW);
const rest = siblings.slice(PREVIEW);
---

<Layout title={title} description={description}>
  <p class="back"><a href="/">&larr; Alle Vorhaben</a></p>
  <h1>{title}</h1>
  <DeadlinePlanner
    client:only="vue"
    vorhaben={v.vorhaben}
    anchorLabel={v.anchorLabel}
    variantLabel={v.variantLabel}
    variants={v.variants}
    defaultSlug={variant.slug}
  />
  <StaticPlan deadlines={variant.deadlines} anchorLabel={v.anchorLabel} />
  {
    siblings.length > 0 && (
      <nav class="places">
        <h2>{v.label} in deiner Stadt</h2>
        <ul>
          {preview.map((s) =>
            s.slug === variant.slug ? (
              <li>
                <span class="here" aria-current="page">
                  {s.label} (aktuell)
                </span>
              </li>
            ) : (
              <li>
                <a href={`/${v.slug}/${s.slug}/`}>
                  {v.label} in {s.label}
                </a>
              </li>
            ),
          )}
        </ul>
        {rest.length > 0 && (
          <details>
            <summary>Alle {siblings.length} Orte</summary>
            <ul>
              {rest.map((s) => (
                <li>
                  <a
                    href={`/${v.slug}/${s.slug}/`}
                    aria-current={s.slug === variant.slug ? "page" : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </nav>
    )
  }
</Layout>

<style>
  .back {
    font-size: var(--fs-sm);
  }
  h1 {
    margin-top: 0.5rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.01em;
  }
  .places {
    margin-top: 2.5rem;
  }
  .places ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .places a {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.4rem 0.9rem;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  /* The current place is a state, not a destination, so it is not a link. */
  .places .here {
    display: inline-block;
    border: 1px solid var(--accent);
    border-radius: 100px;
    padding: 0.4rem 0.9rem;
    font-size: var(--fs-sm);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .places details {
    margin-top: 0.8rem;
    font-size: var(--fs-sm);
  }
  .places summary {
    cursor: pointer;
    color: var(--muted);
  }
  .places details ul {
    margin-top: 0.6rem;
  }
</style>
