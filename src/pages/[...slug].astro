---
import Layout from "../layouts/Layout.astro";
import DeadlinePlanner from "../components/DeadlinePlanner.vue";
import StaticPlan from "../components/StaticPlan.astro";
import { vorhabenRoutes } from "../../lib/vorhaben-routes";
import { BUNDESWEIT_SLUG } from "../../lib/vorhaben-data";
import { appliesTo } from "../../lib/facets";
import { byOffset, offsetLabel } from "../../lib/offset-label";

export function getStaticPaths() {
  return vorhabenRoutes().map((r) => ({ params: { slug: r.path }, props: r }));
}

const { v, variant, title, description, noindex } = Astro.props;
const isPlace = Astro.params.slug !== v.slug;
const crumbs = [
  { name: "Startseite", url: new URL("/", Astro.site).href },
  { name: v.label, url: new URL(`/${v.slug}/`, Astro.site).href },
  ...(isPlace
    ? [
      {
        name: variant.label,
        url: new URL(`/${v.slug}/${variant.slug}/`, Astro.site).href,
      },
    ]
    : []),
];
// Every number below is counted from the plan itself, so the text cannot drift
// away from the Fristen it describes.
const entries = variant.deadlines.filter((d) => appliesTo(d, [])).sort(byOffset);
const earliest = entries[0];
const officeSteps = entries.filter((d) => d.needs_office).map((d) => d.label);
const afterAnchor = entries.filter((d) => (d.offset_days ?? 0) > 0).length;
const undated = entries.filter((d) => d.offset_days === null).length;
const baseIds = new Set(
  (v.variants.find((x) => x.slug === BUNDESWEIT_SLUG)?.deadlines ?? []).map(
    (d) => d.id,
  ),
);
const localSteps = entries
  .filter((d) => !baseIds.has(d.id))
  .map((d) => d.label.split(" ")[0]);

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "ItemList",
      name: title,
      description,
      numberOfItems: entries.length,
      itemListOrder: "https://schema.org/ItemListOrderAscending",
      itemListElement: entries.map((d, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: d.label,
      })),
    },
  ],
};
const siblings = v.variants.filter((s) => s.slug !== BUNDESWEIT_SLUG);
const PREVIEW = 12;
const preview = siblings.slice(0, PREVIEW);
const rest = siblings.slice(PREVIEW);
---

<Layout
  title={title}
  description={description}
  structuredData={structuredData}
  noindex={noindex}
>
  <p class="back"><a href="/">&larr; Alle Vorhaben</a></p>
  <h1 id="static-title">{title}</h1>
  <!-- Keep in sync with the .overview paragraph in DeadlinePlanner.vue, which
  recounts the same sentences once the Ort or the facets change. -->
  <p class="overview prehydrate">
    Der Zeitplan für {v.vorhaben} umfasst <b>{entries.length} Fristen</b>.{" "}
    {earliest && (
      <>
        Die erste ist {earliest.label} ({offsetLabel(earliest, v.anchorLabel)}).{" "}
      </>
    )}
    {afterAnchor > 0 && (
      <>{afterAnchor} davon fallen erst nach dem {v.anchorLabel} an.{" "}</>
    )}
    {officeSteps.length > 0 && (
      <>
        <b>
          {officeSteps.length}{" "}
          {officeSteps.length === 1 ? "Frist braucht" : "Fristen brauchen"}
          {" "}einen Termin beim Amt
        </b>{" "}
        ({officeSteps.join(", ")}). Solche Termine sind je nach Stadt Wochen im
        Voraus vergeben, deshalb steht der Plan rückwärts und nicht als Liste
        zum Abarbeiten.{" "}
      </>
    )}
    {undated > 0 && (
      <>{undated} Fristen sind noch nicht gegen ihre Rechtsgrundlage geprüft.{" "}</>
    )}
    {localSteps.length > 0 && (
      <>In {variant.label} kommen dazu: {localSteps.join(", ")}.</>
    )}
  </p>
  <!-- Holds the height the planner will take, so the page below it does not
  jump when the island renders. -->
  <div class="planner-slot">
    <DeadlinePlanner
      client:only="vue"
      slug={v.slug}
      vorhaben={v.vorhaben}
      anchorLabel={v.anchorLabel}
      anchorName={v.anchorName}
      variantLabel={v.variantLabel}
      variantPreposition={v.variantPreposition}
      variants={v.variants}
      defaultSlug={variant.slug}
    />
  </div>
  <StaticPlan
    deadlines={variant.deadlines}
    anchorLabel={v.anchorLabel}
  />
  {
    siblings.length > 0 && (
      <nav class="places">
        <h2>Örtliche Fristen</h2>
        <p class="places-note">
          Halteverbotszone, Anwohnerparkausweis und Sperrmüll regelt jede
          Kommune in ihrer eigenen Satzung, bundesweit gibt es dafür keine
          Frist. Für diese Orte haben wir sie nachgeschlagen:
        </p>
        <ul>
          {preview.map((s) =>
            s.slug === variant.slug ? (
              <li>
                <span class="here" aria-current="page">
                  {v.label} in {s.label}
                </span>
              </li>
            ) : (
              <li>
                <a href={`/${v.slug}/${s.slug}/`}>
                  {v.label} in {s.label}
                </a>
              </li>
            ),
          )}
        </ul>
        {rest.length > 0 && (
          <details>
            <summary>Alle {siblings.length} Orte</summary>
            <ul>
              {rest.map((s) => (
                <li>
                  <a
                    href={`/${v.slug}/${s.slug}/`}
                    aria-current={s.slug === variant.slug ? "page" : undefined}
                  >
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
      </nav>
    )
  }
</Layout>

<style>
  .overview {
    max-width: 62ch;
    color: var(--muted);
  }
  .overview b {
    color: var(--ink);
    font-weight: 600;
  }
  .back {
    font-size: var(--fs-sm);
  }
  /* ponytail: one number for every plan, split it per Vorhaben if the plans
  ever differ enough in length that the reserve reads as empty space. */
  html[data-js] .planner-slot {
    min-height: 32rem;
  }
  h1 {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }
  .places {
    margin-top: 2rem;
  }
  .places-note {
    max-width: 62ch;
    margin: 0 0 0.75rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .places ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .places a {
    display: inline-block;
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 0.5rem 1rem;
    font-size: var(--fs-sm);
    text-decoration: none;
  }
  .places .here {
    display: inline-block;
    border: 1px solid var(--accent);
    border-radius: 100px;
    padding: 0.5rem 1rem;
    font-size: var(--fs-sm);
    background: var(--accent);
    color: var(--accent-ink);
  }
  .places details {
    margin-top: 0.75rem;
    font-size: var(--fs-sm);
  }
  .places summary {
    cursor: pointer;
    color: var(--muted);
  }
  .places details ul {
    margin-top: 0.5rem;
  }

  @media print {
    .back,
    .places {
      display: none;
    }
  }
</style>
