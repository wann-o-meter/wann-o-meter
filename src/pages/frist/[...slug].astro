---
import Layout from "../../layouts/Layout.astro";
import { ArrowRight, CalendarPlus } from "@lucide/astro";
import FristRechner from "../../components/FristRechner.vue";
import { evaluateRule, nextOccurrence } from "../../../lib/calendar-rule";
import { formatDate } from "../../../lib/format-date";
import { offsetLabel, sourceLabel } from "../../../lib/offset-label";
import { allFristTasks, fristPath, yearsFor } from "../../../lib/tasks";
import { isoToday } from "../../../lib/today";

export function getStaticPaths() {
  return allFristTasks().flatMap(({ task, vorhaben }) => [
    { params: { slug: task.id }, props: { task, vorhaben, year: null } },
    ...yearsFor(task).map((year) => ({
      params: { slug: `${task.id}/${year}` },
      props: { task, vorhaben, year },
    })),
  ]);
}

const { task, vorhaben: plans, year } = Astro.props;
const isAbsolute = task.kind === "statutory-absolute";

// The answer is only computed here for a date the statute fixes by itself. A
// Frist counted from the visitor's own date is worked out in the browser, never
// baked into HTML that goes stale.
const answer = isAbsolute
  ? year
    ? evaluateRule(task.rule!, year, "DE")
    : nextOccurrence(task.rule!, isoToday(), "DE")
  : null;

// A Frist can sit in several plans, so the page belongs to none of them. Which
// one a visitor came from is a question only the browser can answer, from the
// from= parameter the plans put on their links.
const anchorLabel = plans[0]?.anchorLabel ?? "Termin";
const planIndex = Object.fromEntries(plans.map((v) => [v.slug, v.label]));

const title = year
  ? `${task.label} für ${year}: bis wann?`
  : `${task.label}: welche Frist gilt?`;
const description = isAbsolute
  ? `${task.label}${year ? ` für ${year}` : ""}: Stichtag nach ${task.source_label ?? "Gesetz"}, mit Rechenweg.`
  : `${task.label}: die Frist nach ${task.source_label ?? "Gesetz"}, erklärt und mit Rechner für deinen Termin.`;

const crumbs = [
  { name: "Startseite", url: new URL("/", Astro.site).href },
  { name: task.label, url: new URL(`/${fristPath(task.id)}/`, Astro.site).href },
  ...(year
    ? [
      {
        name: String(year),
        url: new URL(`/${fristPath(task.id, year)}/`, Astro.site).href,
      },
    ]
    : []),
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: c.url,
  })),
};
---

<Layout title={title} description={description} structuredData={structuredData}>
  <p class="back"><a data-back href="/">&larr; Startseite</a></p>

  {
    isAbsolute && answer && (
      <>
        <div class="answer">
          <p class="eyebrow">
            {year ? `Steuerjahr ${year}` : "Als Nächstes fällig"}
          </p>
          <p class="date">{formatDate(answer.date)}</p>
          <h1>{title}</h1>
          <p class="basis">
            Grundlage:{" "}
            <a href={task.source_url} rel="nofollow noopener">
              {sourceLabel(task)}
            </a>
          </p>
        </div>
        <ol class="steps">
          {answer.derivation.map((s) => (
            <li>{s.label}</li>
          ))}
        </ol>
        <a
          class="cta"
          href={`/${fristPath(task.id, year ?? Number(answer.date.slice(0, 4)) - 1)}.ics`}
        >
          <CalendarPlus size={16} /> Termin in den Kalender
        </a>
      </>
    )
  }

  {
    !isAbsolute && (
      <>
        <h1>{title}</h1>
        <p class="rule">
          <b>{offsetLabel(task, anchorLabel)}</b>{`, gerechnet vom ${anchorLabel}.`}
        </p>
        <p class="basis">
          Grundlage:{" "}
          <a href={task.source_url} rel="nofollow noopener">
            {sourceLabel(task)}
          </a>
        </p>
      </>
    )
  }

  {task.note && <p class="note">{task.note}</p>}

  {
    !isAbsolute && (
      <FristRechner client:load task={task} anchorLabel={anchorLabel} />
    )
  }

  {
    !isAbsolute && plans.length > 0 && (
      <p class="regionhint">
        Gerechnet wird hier mit den bundesweiten Feiertagen. Im vollständigen
        Plan kannst du deinen Ort angeben, dann zählen die Feiertage deines
        Bundeslands.
      </p>
    )
  }

  {
    plans.length > 0 && (
      <nav class="bundle">
        <h2>Diese Frist steht nicht allein</h2>
        <p class="lede">
          Sie gehört zum {plans.map((v) => v.label).join(" und zum ")}-Plan. Ein
          Datum eingeben, und der Plan rechnet alle Fristen zurück, mit den
          Feiertagen deines Bundeslands.
        </p>
        {plans.map((v) => (
          <a class="cta" data-plan-cta={v.slug} href={`/${v.slug}/`}>
            {v.label} planen <ArrowRight size={16} />
          </a>
        ))}
      </nav>
    )
  }

  {
    year && (
      <p class="otheryears">
        Andere Jahre:{" "}
        {yearsFor(task)
          .filter((y) => y !== year)
          .map((y) => (
            <a href={`/${fristPath(task.id, y)}/`}>{y}</a>
          ))}
      </p>
    )
  }

  <script is:inline define:vars={{ planIndex }}>
    // The plan a visitor came from lives in the url: a view transition leaves
    // document.referrer empty, and a Frist can belong to more than one plan.
    document.addEventListener("astro:page-load", () => {
      const from = new URLSearchParams(location.search).get("from");
      const label = planIndex[from];
      if (!label) return;
      const back = document.querySelector("[data-back]");
      if (back) {
        back.setAttribute("href", `/${from}/`);
        back.textContent = `← ${label}-Plan`;
      }
      // They came from that plan, so inviting them to start it is noise.
      document.querySelector(`[data-plan-cta="${from}"]`)?.remove();
    });
  </script>
</Layout>

<style>
  .back {
    font-size: var(--fs-sm);
  }
  /* The date is the answer, so it comes before the question. */
  .answer .eyebrow {
    margin: 0;
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .answer .date {
    margin: 0.2rem 0 0.6rem;
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .answer h1 {
    margin: 0 0 0.5rem;
    font-size: var(--fs-lg);
  }
  .basis {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .rule {
    max-width: 62ch;
    font-size: var(--fs-md);
  }
  .rule b {
    color: var(--ink);
  }
  .note {
    max-width: 62ch;
    color: var(--muted);
  }
  .steps {
    max-width: 62ch;
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .steps li {
    margin-bottom: 0.3rem;
  }
  .regionhint {
    max-width: 62ch;
    margin-top: 1rem;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .bundle {
    margin-top: 2.5rem;
  }
  .bundle .lede {
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--fs-sm);
  }
  .bundle .cta {
    margin-right: 0.6rem;
  }
  .otheryears {
    margin-top: 2rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .otheryears a {
    margin-right: 0.6rem;
  }
</style>
