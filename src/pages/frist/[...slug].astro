---
import Layout from "../../layouts/Layout.astro";
import { ArrowRight, CalendarPlus } from "@lucide/astro";
import FristRechner from "../../components/FristRechner.vue";
import { evaluateRule, nextOccurrence } from "../../../lib/calendar-rule";
import { formatDate } from "../../../lib/format-date";
import { durationLabel, offsetLabel, sourceLabel } from "../../../lib/offset-label";
import { allFristTasks, fristPath, yearsFor } from "../../../lib/tasks";
import { isPast, isoToday } from "../../../lib/today";
import { lastChanged } from "../../../lib/git-dates";
import { STATUTE_QUOTES } from "../../../lib/statute-quotes";

export function getStaticPaths() {
  return allFristTasks().flatMap(({ task, vorhaben }) => [
    { params: { slug: task.id }, props: { task, vorhaben, year: null } },
    ...yearsFor(task).map((year) => ({
      params: { slug: `${task.id}/${year}` },
      props: { task, vorhaben, year },
    })),
  ]);
}

const { task, vorhaben: plans, year } = Astro.props;
const isAbsolute = task.kind === "statutory-absolute";

// The answer is only computed here for a date the statute fixes by itself. A
// Frist counted from the visitor's own date is worked out in the browser, never
// baked into HTML that goes stale.
const answer = isAbsolute
  ? year
    ? evaluateRule(task.rule!, year, "DE")
    : nextOccurrence(task.rule!, isoToday(), "DE")
  : null;

// A Frist can sit in several plans, so the page belongs to none of them. Which
// one a visitor came from is a question only the browser can answer, from the
// from= parameter the plans put on their links.
const anchorLabel = plans[0]?.anchorLabel ?? "Termin";
const planIndex = Object.fromEntries(plans.map((v) => [v.slug, v.label]));

// The parent of a task with year pages is the hub for all of them. Without the
// table it would repeat whichever year is currently next and compete with that
// year's own page for the same words.
const years = year ? [] : yearsFor(task);
const yearRows = years.map((y) => {
  const date = evaluateRule(task.rule!, y, "DE").date;
  return { year: y, date, past: isPast(date) };
});

const source = task.source_label ?? "Gesetz";
// The title is the question someone types, answered with the number and the
// Paragraf: "Ummeldung nach Umzug: 2 Wochen Frist (§ 17 BMG)".
const name = task.search_label ?? task.label;
const paragraph = task.source_label ? ` (${task.source_label})` : "";
const title = year
  ? `${name} für ${year}: Stichtag${paragraph}`
  : yearRows.length > 0
    ? `${name}: Stichtag für jedes Jahr${paragraph}`
    : task.offset_label
      ? `${name}: ${task.offset_label}${paragraph}`
      : task.offset_days
        ? `${name}: ${durationLabel(Math.abs(task.offset_days))} Frist${paragraph}`
        : `${name}: welche Frist gilt?${paragraph}`;
const description = year
  ? `${task.label} für ${year}: Stichtag nach ${source}, mit Rechenweg.`
  : yearRows.length > 0
    ? `${task.label}: Stichtag nach ${source}, mit Rechenweg und dem Termin für jedes Jahr.`
    : isAbsolute
      ? `${task.label}: Stichtag nach ${source}, mit Rechenweg.`
      : `${task.label}: die Frist nach ${source}, erklärt und mit Rechner für deinen Termin.`;

// A page is only as fresh as the yaml behind it, and saying so is the cheapest
// trust signal a page about Gesetze has.
const updated = lastChanged(`data/fristen/${task.id}.yaml`);

// The statute in its own words, pulled from the official XML by
// scripts/gesetze.mjs. Nothing here is written by hand or by a model.
const statute = STATUTE_QUOTES[task.id];

const crumbs = [
  { name: "Startseite", url: new URL("/", Astro.site).href },
  { name: "Fristen", url: new URL("/frist/", Astro.site).href },
  { name: task.label, url: new URL(`/${fristPath(task.id)}/`, Astro.site).href },
  ...(year
    ? [
      {
        name: String(year),
        url: new URL(`/${fristPath(task.id, year)}/`, Astro.site).href,
      },
    ]
    : []),
];
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: crumbs.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.name,
        item: c.url,
      })),
    },
    {
      "@type": "WebPage",
      name: title,
      description,
      inLanguage: "de-DE",
      ...(updated ? { dateModified: updated } : {}),
      ...(task.source_url
        ? { citation: { "@type": "Legislation", name: source, url: task.source_url } }
        : {}),
    },
  ],
};
---

<Layout title={title} description={description} structuredData={structuredData}>
  <nav class="crumbs" aria-label="Brotkrumen">
    {
      crumbs.map((c, i) => (
        <>
          {i > 0 && <span aria-hidden="true"> &rsaquo; </span>}
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={new URL(c.url).pathname}>{c.name}</a>
          )}
        </>
      ))
    }
  </nav>

  {
    plans.length > 0 && (
      <p class="parents" data-parents>
        Diese Frist gehört zu:{" "}
        {plans.map((v, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> &middot; </span>}
            <a href={`/${v.slug}/`}>{v.label}</a>
          </>
        ))}
      </p>
    )
  }

  {
    isAbsolute && answer && (
      <>
        <div class="answer">
          <p class="eyebrow">
            {year ? `Steuerjahr ${year}` : "Als Nächstes fällig"}
          </p>
          <p class="date">{formatDate(answer.date)}</p>
          <h1>{title}</h1>
          <p class="basis">
            Grundlage:{" "}
            <a href={task.source_url} rel="nofollow noopener">
              {sourceLabel(task)}
            </a>
          </p>
        </div>
        <ol class="steps">
          {answer.derivation.map((s) => (
            <li>{s.label}</li>
          ))}
        </ol>
        <a
          class="cta"
          href={`/${fristPath(task.id, year ?? Number(answer.date.slice(0, 4)) - 1)}.ics`}
        >
          <CalendarPlus size={16} /> Termin in den Kalender
        </a>
      </>
    )
  }

  {
    !isAbsolute && (
      <>
        <h1>{title}</h1>
        <p class="rule">
          <b>{offsetLabel(task, anchorLabel)}</b>{`, gerechnet vom ${anchorLabel}.`}
        </p>
        <p class="basis">
          Grundlage:{" "}
          <a href={task.source_url} rel="nofollow noopener">
            {sourceLabel(task)}
          </a>
        </p>
      </>
    )
  }

  {task.note && <p class="note">{task.note}</p>}

  {
    (task.authority || task.documents) && (
      <dl class="facts">
        {task.authority && (
          <>
            <dt>Wo?</dt>
            <dd>{task.authority}</dd>
          </>
        )}
        {task.documents && (
          <>
            <dt>Benötigte Unterlagen</dt>
            <dd>
              <ul>
                {task.documents.map((d) => (
                  <li>{d}</li>
                ))}
              </ul>
            </dd>
          </>
        )}
      </dl>
    )
  }

  {
    year && answer && isPast(answer.date) && (
      <p class="expired">
        Dieser Stichtag ist vorbei. Der nächste steht auf{" "}
        <a href={`/${fristPath(task.id)}/`}>der Übersicht aller Jahre</a>.
      </p>
    )
  }

  {
    statute && (
      <figure class="statute">
        <figcaption>
          {statute.enbez} {statute.titel}
          {!statute.complete && " (Auszug)"}
        </figcaption>
        <blockquote cite={statute.url}>
          {statute.absaetze.map((segments) => (
            <p>
              {segments.map((s) => {
                const inner = s.href ? (
                  <a href={s.href} rel="nofollow noopener">
                    {s.text}
                  </a>
                ) : (
                  s.text
                );
                return s.mark ? <mark>{inner}</mark> : inner;
              })}
            </p>
          ))}
        </blockquote>
        <p class="attribution">
          Wortlaut von{" "}
          <a href={statute.url} rel="nofollow noopener">
            gesetze-im-internet.de
          </a>
          {statute.stand && `, Stand ${formatDate(statute.stand)}`}. Gesetze
          genießen nach § 5 Abs. 1 UrhG keinen urheberrechtlichen Schutz.
        </p>
      </figure>
    )
  }

  {
    !isAbsolute && (
      <FristRechner client:load task={task} anchorLabel={anchorLabel} />
    )
  }

  {
    plans.length > 0 && (
      <nav class="bundle">
        <h2>Diese Frist steht nicht allein</h2>
        <p class="lede">
          Sie gehört zum {plans.map((v) => v.label).join(" und zum ")}-Plan. Ein
          Datum eingeben, und der Plan rechnet alle Fristen zurück, mit den
          Feiertagen deines Bundeslands.
        </p>
        {plans.map((v) => (
          <a class="cta" data-plan-cta={v.slug} href={`/${v.slug}/`}>
            {v.label} planen <ArrowRight size={16} />
          </a>
        ))}
      </nav>
    )
  }

  {
    yearRows.length > 0 && (
      <section class="years">
        <h2>Der Stichtag für jedes Jahr</h2>
        <p class="lede">
          Jede Zeile rechnet denselben Weg für ein anderes Jahr durch. Das Jahr
          in der ersten Spalte ist das Steuerjahr, der Stichtag liegt im Jahr
          danach.
        </p>
        <table>
          <thead>
            <tr>
              <th scope="col">Jahr</th>
              <th scope="col">Abgabe bis</th>
            </tr>
          </thead>
          <tbody>
            {yearRows.map((r) => (
              <tr class:list={{ past: r.past }}>
                <th scope="row">
                  <a href={`/${fristPath(task.id, r.year)}/`}>{r.year}</a>
                </th>
                <td>
                  {formatDate(r.date)}
                  {r.past && <span class="flag">vorbei</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    )
  }

  {
    year && (
      <p class="otheryears">
        <a href={`/${fristPath(task.id)}/`}>Alle Jahre im Überblick</a>
        <span aria-hidden="true"> &middot; </span>
        {yearsFor(task)
          .filter((y) => y !== year)
          .map((y) => (
            <a href={`/${fristPath(task.id, y)}/`}>{y}</a>
          ))}
      </p>
    )
  }

  <p class="stand">
    {
      task.checked_on && (
        <>
          Stand:{" "}
          <time datetime={task.checked_on}>{formatDate(task.checked_on)}</time>,
          an dem Tag zuletzt gegen den Gesetzestext gehalten.{" "}
        </>
      )
    }
    {
      updated && (
        <>
          Zuletzt geändert am{" "}
          <time datetime={updated}>{formatDate(updated.slice(0, 10))}</time>.{" "}
        </>
      )
    }
    <a href="/aenderungen/">Alle Änderungen</a>
    <span aria-hidden="true"> &middot; </span>
    <a href="/impressum/#ki">Wie diese Seite entsteht</a>
  </p>

  <script is:inline define:vars={{ planIndex }}>
    // Where a visitor came from is the referrer's job, not the url's: the page
    // is the same page either way and should have one address.
    document.addEventListener("astro:page-load", () => {
      const ref = document.referrer;
      if (!ref || !ref.startsWith(location.origin)) return;
      const from = new URL(ref).pathname.split("/")[1];
      if (!planIndex[from]) return;
      // They just came from that plan, so inviting them to start it is noise.
      document.querySelector(`[data-plan-cta="${from}"]`)?.remove();
    });
  </script>
</Layout>

<style>
  .crumbs {
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .parents {
    margin: 0.4rem 0 1.2rem;
    font-size: var(--t-meta);
    color: var(--muted);
  }
  /* The date is the answer, so it comes before the question. */
  .answer .eyebrow {
    margin: 0;
    font-size: var(--t-meta);
    font-weight: var(--fw-semibold);
    color: var(--muted);
  }
  .answer .date {
    margin: 0.2rem 0 0.6rem;
    font-size: var(--t-display);
    font-weight: var(--fw-semibold);
    line-height: 1.1;
    color: var(--accent);
  }
  .answer h1 {
    margin: 0 0 0.5rem;
    font-size: var(--t-section);
  }
  .basis {
    margin: 0 0 1rem;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .rule {
    max-width: 62ch;
    font-size: var(--t-body);
  }
  .rule b {
    color: var(--ink);
  }
  .note {
    max-width: 62ch;
    color: var(--muted);
  }
  .facts {
    max-width: 62ch;
    margin: 1.2rem 0;
  }
  .facts dt {
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .facts dd {
    margin: 0.2rem 0 0.9rem;
  }
  .facts ul {
    margin: 0;
    padding-left: 1.2rem;
  }
  .steps {
    max-width: 62ch;
    margin: 0 0 1rem;
    padding-left: 1.2rem;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .steps li {
    margin-bottom: 0.3rem;
  }
  .bundle {
    margin-top: 2.5rem;
  }
  .bundle .lede {
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .bundle .cta {
    margin-right: 0.6rem;
  }
  .otheryears {
    margin-top: 2rem;
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .otheryears a {
    margin-right: 0.6rem;
  }
  /* The statute itself, which is what the page has to show when nobody has
  entered a date yet. Set apart so it reads as a quotation and not as our text. */
  .statute {
    margin: 1.5rem 0 2rem;
    max-width: 62ch;
  }
  .statute figcaption {
    font-size: var(--t-meta);
    font-weight: var(--fw-semibold);
    color: var(--muted);
  }
  .statute blockquote {
    margin: 0.5rem 0 0.6rem;
    padding-left: 1rem;
    border-left: 2px solid var(--line);
  }
  .statute blockquote p {
    margin: 0 0 0.6rem;
  }
  .statute blockquote p:last-child {
    margin-bottom: 0;
  }
  .statute mark {
    background: var(--mark, rgb(255 214 0 / 0.28));
    color: inherit;
    padding: 0.05em 0.1em;
    border-radius: 2px;
  }
  .statute .attribution {
    margin: 0;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .expired {
    max-width: 62ch;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    font-size: var(--t-meta);
  }
  .years {
    margin-top: 2.5rem;
  }
  .years h2 {
    font-size: var(--t-body);
  }
  .years .lede {
    max-width: 62ch;
    color: var(--muted);
    font-size: var(--t-meta);
  }
  .years table {
    border-collapse: collapse;
    text-align: left;
  }
  .years th,
  .years td {
    padding: 0.45rem 1.5rem 0.45rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: var(--fw-regular);
  }
  .years thead th {
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .years tbody td {
    font-variant-numeric: tabular-nums;
  }
  .years .past {
    color: var(--muted);
  }
  .years .flag {
    margin-left: 0.5rem;
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .stand {
    margin-top: 2.5rem;
    color: var(--muted);
    font-size: var(--t-meta);
  }
</style>
