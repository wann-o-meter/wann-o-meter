---
import Layout from "../layouts/Layout.astro";
import { formatDate } from "../../lib/format-date";
import { dataChanges } from "../../lib/git-dates";
import { allFristTasks, fristPath } from "../../lib/tasks";
import { loadAllVorhaben } from "../../lib/vorhaben-data";
import { REPO_URL } from "../../lib/github-issue";

// The history of the data, straight from git. Nobody writes this list, so it
// cannot claim a change that did not happen or hide one that did.
const labels = new Map(allFristTasks().map(({ task }) => [task.id, task.label]));

function fristIdOf(file: string): string | null {
  const m = file.match(/^data\/fristen\/([^/.]+)\./);
  return m && labels.has(m[1]) ? m[1] : null;
}

// Only the files a person edits by hand. The Feiertage and Schulferien under
// data/ are regenerated by a script, and a rerun of that changes no Frist.
const RULE_PATHS = [
  "data/fristen",
  "data/vorhaben.yaml",
  ...loadAllVorhaben().map((v) => `data/${v.slug}`),
];

const changes = dataChanges(RULE_PATHS, 60).map((c) => ({
  ...c,
  fristen: [...new Set(c.files.map(fristIdOf).filter((id) => id !== null))],
}));

const title = "Änderungen an den Fristen";
const description =
  "Jede Änderung an den Fristen und ihren Quellen, mit Datum, direkt aus der Versionsgeschichte.";
---

<!-- A log of commits is nothing to rank for, and it would compete with the
Frist pages it links to. It keeps its links: noindex, follow. -->
<Layout title={title} description={description} noindex>
  <nav class="crumbs" aria-label="Brotkrumen">
    <a href="/">Startseite</a>
    <span aria-hidden="true"> &rsaquo; </span>
    <span aria-current="page">Änderungen</span>
  </nav>
  <h1>{title}</h1>
  <p class="lede">
    Diese Liste kommt aus der Versionsgeschichte des Projekts und zeigt nur
    Änderungen an den Fristen selbst, nicht am Aussehen der Seiten und nicht an
    den Feiertagen, die ein Skript nachlädt.
  </p>
  <p class="lede">
    Vollständig ist sie nicht: sie zeigt die letzten Einträge und fasst pro
    Commit zusammen. Die ganze Geschichte mit jeder einzelnen Zeile steht im{" "}
    <a href={REPO_URL} rel="noopener">Repository auf GitHub</a>.
  </p>

  <ol class="changes">
    {
      changes.map((c) => (
        <li>
          <time datetime={c.date}>{formatDate(c.date.slice(0, 10))}</time>
          <p class="subject">{c.subject}</p>
          {c.fristen.length > 0 && (
            <p class="which">
              {c.fristen.map((id, i) => (
                <>
                  {i > 0 && <span aria-hidden="true"> &middot; </span>}
                  <a href={`/${fristPath(id)}/`}>{labels.get(id)}</a>
                </>
              ))}
            </p>
          )}
        </li>
      ))
    }
  </ol>
</Layout>

<style>
  .crumbs {
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .lede {
    max-width: 62ch;
    color: var(--muted);
  }
  .changes {
    list-style: none;
    padding: 0;
    max-width: 62ch;
  }
  .changes li {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
  }
  .changes time {
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--t-meta);
    color: var(--muted);
  }
  .subject {
    margin: 0.2rem 0 0;
  }
  .which {
    margin: 0.3rem 0 0;
    font-size: var(--t-meta);
  }
</style>
