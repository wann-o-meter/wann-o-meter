---
import Layout from "../layouts/Layout.astro";
import { feedbackIssueUrl } from "../../lib/github-issue";
---

<Layout
  title="Feedback geben"
  description="Fehlende Frist, falsches Datum oder ein Vorschlag: kurz beschreiben und abschicken."
  noindex
>
  <h1>Feedback geben</h1>
  <p class="lede">
    Fehlt eine Frist, stimmt ein Datum nicht oder fehlt deine Gemeinde? Schreib
    kurz, worum es geht. Das Formular öffnet deine Mail-App mit dem fertigen
    Text, es werden keine Daten an uns übertragen, bevor du sie abschickst.
  </p>

  <form id="feedback-form">
    <label class="field">
      <span class="label">Worum geht es?</span>
      <select id="topic" name="topic">
        <option>Eine Frist fehlt</option>
        <option>Ein Datum oder eine Quelle stimmt nicht</option>
        <option>Meine Gemeinde fehlt</option>
        <option>Etwas anderes</option>
      </select>
    </label>
    <label class="field">
      <span class="label">Welche Seite betrifft es? <span class="opt">optional</span></span>
      <input id="page" name="page" type="text" placeholder="z. B. Umzug in Tübingen" />
    </label>
    <label class="field">
      <span class="label">Deine Nachricht</span>
      <textarea id="message" name="message" rows="6" required></textarea>
    </label>
    <p class="actions">
      <button type="submit" class="btn-primary">Mail öffnen</button>
      <a href={feedbackIssueUrl()} rel="noopener">Lieber als GitHub-Issue</a>
    </p>
  </form>
</Layout>

<script>
  import { feedbackMailtoUrl } from "../../lib/github-issue";

  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("feedback-form");
    if (!(form instanceof HTMLFormElement)) return;
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const page = String(data.get("page") ?? "").trim();
      const body = `${data.get("message")}\n\n${page ? `Seite: ${page}\n` : ""}`;
      window.location.href = feedbackMailtoUrl(
        `Wann-O-Meter: ${data.get("topic")}`,
        body,
      );
    });
  });
</script>

<style>
  .lede {
    color: var(--muted);
    max-width: 60ch;
  }
  form {
    max-width: 34rem;
  }
  .field {
    margin: 0 0 var(--s-2);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    font-size: var(--t-meta);
  }

</style>
