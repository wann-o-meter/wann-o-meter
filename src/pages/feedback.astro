---
import Layout from "../layouts/Layout.astro";
import TallyEmbed from "../components/TallyEmbed.astro";
import { feedbackIssueUrl, feedbackMailtoUrl } from "../../lib/github-issue";
import { TALLY_FORM_ID } from "../../lib/tally";
---

<Layout
  title="Feedback geben"
  description="Fehlende Frist, falsches Datum oder ein Vorschlag: kurz beschreiben und abschicken."
  noindex
>
  <h1>Feedback geben</h1>
  <p class="lede">
    Fehlt eine Frist, stimmt ein Datum nicht oder fehlt deine Gemeinde? Schreib
    kurz, worum es geht.
  </p>

  <TallyEmbed id={TALLY_FORM_ID} title="Feedback zu Wann-O-Meter" />

  <p class="actions">
    <a href={feedbackMailtoUrl()}>Lieber per Mail</a>
    <a href={feedbackIssueUrl()} rel="noopener">Lieber als GitHub-Issue</a>
  </p>
</Layout>

<style>
  .lede {
    color: var(--muted);
    max-width: 60ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.2rem;
    margin-top: var(--s-3);
    font-size: var(--t-meta);
  }
</style>
