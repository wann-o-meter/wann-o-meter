---
import { ArrowLeft } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import FeedbackLink from "../../components/FeedbackLink.astro";
import DeadlinePlanner from "../../components/DeadlinePlanner.vue";
import { loadAllVorhaben, BUNDESWEIT_SLUG } from "../../../lib/vorhaben-data";

// One page per Vorhaben, and the whole plan is in its query. Nothing here is
// worth indexing: the address a search result should carry is /<vorhaben>/.
export function getStaticPaths() {
  return loadAllVorhaben().map((v) => ({ params: { vorhaben: v.slug }, props: { v } }));
}

const { v } = Astro.props;
---

<Layout
  title={`${v.label}: dein Plan`}
  description={`Dein Zeitplan für ${v.vorhaben} mit Datum, Quelle und Kalender-Export.`}
  noindex={true}
  canonical={`/${v.slug}/`}
>
  <p class="back">
    <a class="back-link" href={`/${v.slug}/`}>
      <ArrowLeft size={16} /> {v.label}
    </a>
  </p>
  <div class="planner-slot">
    <DeadlinePlanner
      client:only="vue"
      slug={v.slug}
      vorhaben={v.vorhaben}
      anchorLabel={v.anchorLabel}
      anchorName={v.anchorName}
      anchorPersonal={v.anchorPersonal}
      variantLabel={v.variantLabel}
      variantPreposition={v.variantPreposition}
      variants={v.variants}
      defaultSlug={BUNDESWEIT_SLUG}
    />
  </div>
  <FeedbackLink />
</Layout>

<style>
  /* Holds the height the plan will take, so the page does not spring open when
  the island arrives. Same reserve as the wizard slot on the Vorhaben page. */
  html[data-js] .planner-slot {
    min-height: 32rem;
  }
</style>
