---
// Merged category-overview + page-detail route for the generic YAML-driven
// pages system (lib/pages.ts). A single [...path] catch-all is required
// here (not two separate [category]/index.astro + [category]/[slug].astro
// files, as before nesting existed) because Astro rest params must be the
// LAST dynamic segment in a route - with an arbitrary-depth category tree
// there's no fixed number of leading segments to give their own named
// param. Static routes (/feiertage/, /kalender/, ...) always win over this
// catch-all regardless of file placement (Astro's route-priority order:
// static > dynamic > rest params), so RESERVED_CATEGORIES is still the only
// thing keeping a data/ folder from shadowing them.
//
// getStaticPaths() emits one entry per category NODE (both intermediate,
// e.g. "sport", and leaf-with-pages, e.g. "sport/fussball/bundesliga" - see
// getAllCategoryNodes()) rendering the category-overview template, plus one
// entry per PAGE rendering the page-detail template - same two templates
// [category]/index.astro and [category]/[slug].astro used to render,
// unchanged in substance, just merged into one file with an N-level
// breadcrumb instead of a fixed 2-level one.
import { Braces, CalendarPlus, Copy, Download } from "@lucide/astro";
import Layout from "../layouts/Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import DateListControls from "../components/DateListControls.astro";
import SourceList from "../components/SourceList.astro";
import YearGrid from "../components/YearGrid.astro";
import BandChart from "../components/BandChart.astro";
import {
  getAllCategoryNodes,
  getAllPages,
  getCategoryMeta,
  getPageEvents,
  pageLocation,
} from "../../lib/pages";
import type { CategoryNode, Page } from "../../lib/pages";
import { breadcrumbNode, datasetNode, eventNode, faqNode, graph } from "../../lib/structured-data";
import { formatDateWithWeekday, toDate } from "../../lib/format-date";
import {
  eventsInYear,
  shouldIndexYear,
  siblingPages,
  stateSlug,
  yearCopy,
  yearHref,
  yearIndex,
  yearLabel,
  yearSubjectCode,
} from "../../lib/year-pages";
import { buildYearGrid, shouldRenderYearGrid } from "../../lib/year-grid";
import type { YearGridMonth } from "../../lib/year-grid";
import { buildBandChart, defaultWindow, hasCoverage } from "../../lib/band-chart";
import type { BandChart as BandChartData, BandChartRowInput } from "../../lib/band-chart";
import { STATES } from "../../lib/states";

type CategoryProps = { kind: "category"; node: CategoryNode };
type PageProps = { kind: "page"; page: Page };
type YearProps = { kind: "year"; page: Page; year: number };

export function getStaticPaths() {
  const categoryEntries = getAllCategoryNodes().map((node) => ({
    params: { path: node.path },
    props: { kind: "category" as const, node } satisfies CategoryProps,
  }));
  const pages = getAllPages();
  const pageEntries = pages.map((p) => ({
    params: { path: `${p.category}/${p.slug}` },
    props: { kind: "page" as const, page: p } satisfies PageProps,
  }));
  // Year-scoped variants of the per-state pages (lib/year-pages.ts): the
  // evergreen /urlaubsfenster/nw/ above is untouched and stays canonical to
  // itself - these are additional URLs, not replacements.
  const yearEntries = pages.flatMap((page) =>
    (yearIndex().get(`${page.category}/${page.slug}`) ?? []).map((year) => ({
      params: { path: `${page.category}/${page.slug}/${year}` },
      props: { kind: "year" as const, page, year } satisfies YearProps,
    })),
  );
  return [...categoryEntries, ...pageEntries, ...yearEntries];
}

const props = Astro.props as CategoryProps | PageProps | YearProps;

// The years a per-state page has its own year pages for - drives the pill row
// on both the evergreen page and the year pages themselves.
function yearsFor(page: Page): number[] {
  return yearIndex().get(`${page.category}/${page.slug}`) ?? [];
}

interface Crumb {
  name: string;
  href: string;
}

const ROOT_CRUMB: Crumb = { name: "Startseite", href: "/" };

// Breadcrumb ancestors shared by all three kinds: every prefix of the
// category's segments, each resolved to its own display name via
// getCategoryMeta() - works at any depth (1 for the existing depth-1
// categories, up to 4).
function ancestorCrumbs(segments: string[]): Crumb[] {
  return segments.map((_, i) => {
    const ancestorPath = segments.slice(0, i + 1).join("/");
    return { name: getCategoryMeta(ancestorPath).name, href: `/${ancestorPath}/` };
  });
}

// One list, two consumers: <Breadcrumbs> renders the relative hrefs, the
// BreadcrumbList JSON-LD needs them absolute. Deriving both from the same
// array is what keeps the visible trail and the structured one in step.
function absoluteCrumbs(crumbs: Crumb[]) {
  return crumbs.map((c) => ({ name: c.name, url: new URL(c.href, Astro.site).href }));
}

// The schulferien.org-shaped overview: one row per scope page in a leaf
// category, day columns filled where that scope's events cover the day.
// STRUCTURAL, not a per-category allowlist (same rule lib/year-pages.ts
// documents for its own state-code detection) - any leaf category with
// multiple scope pages qualifies, point-shaped or range-shaped alike (a
// single-day Feiertag and a multi-week Ferien window are just a narrow vs.
// wide band on the same chart). Today that is Feiertage, Schulferien,
// Urlaubsfenster (all state-coded) and Saisonkalender (fruit/vegetable-
// coded, no state at all) - a future multi-scope category needs no change
// here to get the same view.
//
// A category whose pages mix state-coded and non-state-coded scopes (like
// Feiertage's 16 German states alongside ~200 countries) narrows to the
// state-coded subset when there are enough of them - the two aren't the
// same comparison axis, and 200 rows would be as unusable as 200 columns
// once was in the matrix this view replaced.
//
// State-coded pages additionally get a Feiertage overlay, correlated by
// state code via stateSlug() - the two categories don't otherwise know
// about each other. A page IS its own would-be overlay when the category
// under view already is Feiertage, so that case is skipped rather than
// doubling every cell onto itself.
interface CategoryBandChart {
  chart: BandChartData;
  primaryLabel: string;
  accentLabel?: string;
}

function buildCategoryBandChart(node: CategoryNode, allPages: Page[]): CategoryBandChart | null {
  const stateCoded = node.pages.filter((p) => yearSubjectCode(p.category, p.slug) !== undefined);
  const scopePages = stateCoded.length >= 2 ? stateCoded : node.pages;
  if (scopePages.length < 2) return null;

  const todayIso = new Date().toISOString().slice(0, 10);
  const window = defaultWindow(todayIso);
  let accentUsed = false;

  const rows: BandChartRowInput[] = scopePages.map((page) => {
    const code = yearSubjectCode(page.category, page.slug);
    const ranges: BandChartRowInput["ranges"] = getPageEvents(page).map((e) => ({
      start: e.date,
      end: e.to ?? e.date,
      title: e.label,
      kind: "primary" as const,
    }));
    const feiertagePage = code && allPages.find((p) => p.category === "feiertage" && p.slug === stateSlug("feiertage", code));
    const isSelf = feiertagePage && feiertagePage.category === page.category && feiertagePage.slug === page.slug;
    if (feiertagePage && !isSelf) {
      accentUsed = true;
      ranges.push(
        ...getPageEvents(feiertagePage).map((e) => ({ start: e.date, end: e.to ?? e.date, title: e.label, kind: "accent" as const })),
      );
    }
    return {
      scopeId: page.slug,
      label: code ? STATES[code] : page.meta.title,
      href: `/${page.category}/${page.slug}/`,
      layerId: `${page.category.replace(/\//g, "-")}--${page.slug}`,
      ranges,
    };
  });
  rows.sort((a, b) => a.label.localeCompare(b.label, "de"));

  const chart = buildBandChart(rows, window.start, window.end, todayIso);
  // Escape hatch: a chart with nothing to show in the rendered window (a
  // long-range or seasonal-elsewhere category, right now) is worse than no
  // chart at all - same principle as lib/year-grid.ts's own density guard.
  if (!hasCoverage(chart)) return null;

  return {
    chart,
    primaryLabel: getCategoryMeta(node.path).name,
    accentLabel: accentUsed ? getCategoryMeta("feiertage").name : undefined,
  };
}

function buildCategoryView(node: CategoryNode) {
  const categoryMeta = getCategoryMeta(node.path);
  const sortedPages = [...node.pages].sort((a, b) => a.meta.title.localeCompare(b.meta.title, "de"));
  const childCategories = node.childPaths
    .map((childPath) => ({ path: childPath, meta: getCategoryMeta(childPath) }))
    .sort((a, b) => a.meta.name.localeCompare(b.meta.name, "de"));
  const description = categoryMeta.description || `Seiten im Themenbereich "${categoryMeta.name}".`;
  const pageUrl = new URL(`/${node.path}/`, Astro.site).href;
  const crumbs = [ROOT_CRUMB, ...ancestorCrumbs(node.segments)];
  const structuredData = graph([
    breadcrumbNode(absoluteCrumbs(crumbs)),
    datasetNode({
      name: categoryMeta.name,
      description,
      url: pageUrl,
      // Only leaf categories (pages of their own) have an all.json - a pure
      // intermediate node (e.g. "sport" with only child categories) has
      // nothing of its own to bundle, so it lists no distribution at all
      // rather than pointing at one that 404s.
      distributions:
        sortedPages.length > 0
          ? [{ url: new URL(`/api/v1/${node.path}/all.json`, Astro.site).href, encodingFormat: "application/json" }]
          : [],
    }),
  ]);
  const bandChart = buildCategoryBandChart(node, getAllPages());
  return { node, categoryMeta, sortedPages, childCategories, crumbs, description, structuredData, bandChart };
}

function buildPageView(page: Page) {
  const { category, meta, data } = page;
  const rawData = data.raw_data as Record<string, unknown>;
  // getPageEvents() sorts chronologically, right for every other category
  // (a calendar-style read of "what's next") - but the "-O-Meter" framing is
  // earned specifically here: Urlaubsfenster's whole pitch is "which window
  // gets you the most days off per vacation day taken", so its list leads
  // with the best ratio (PageEvent.value, see lib/pages.ts) instead of the
  // next chronological date.
  const events =
    category === "urlaubsfenster"
      ? [...getPageEvents(page)].sort((a, b) => (b.value ?? 0) - (a.value ?? 0))
      : getPageEvents(page);
  const years = [...new Set(events.map((f) => toDate(f.date).getFullYear()))].sort();
  // Soonest upcoming entry, chronologically - independent of `events`'
  // display order above (Urlaubsfenster's own best-ratio-first sort isn't
  // "what's next"). Build-time "now" (same tradeoff data/feiertage/
  // generator.ts's own nextHolidayBlurb already makes): a build cycle stale
  // is still more useful than nothing, and this is a static site.
  const todayIso = new Date().toISOString().slice(0, 10);
  const upcoming = [...events].filter((e) => e.date >= todayIso).sort((a, b) => a.date.localeCompare(b.date));
  const nextEvent = upcoming[0];
  // ponytail: only the next 50 upcoming dates become schema.org Event nodes.
  // A long-range page (data/astronomie/sonnenfinsternis: 452 eclipses, 1901-
  // 2100) would otherwise inline ~94 KB of JSON-LD describing entries no
  // search engine will ever surface - an Event node for the year 1901 is
  // pure page weight. The datasetNode below still advertises the COMPLETE
  // dataset through its JSON/ICS distributions, and the visible row list
  // still carries every single year.
  const structuredEvents = upcoming.slice(0, 50);
  const preview = typeof rawData.clean_markdown_preview === "string" ? rawData.clean_markdown_preview : "";
  const columns = Array.isArray(rawData.columns) ? (rawData.columns as string[]) : [];
  const rowsPreview = Array.isArray(rawData.rows_preview) ? (rawData.rows_preview as Record<string, string>[]) : [];
  const segments = category.split("/");
  const pageUrl = new URL(`/${category}/${page.slug}/`, Astro.site).href;
  const description = meta.description || meta.title;
  const eventLocation = pageLocation(page);
  const eventImage = new URL("/og-image.png", Astro.site).href;
  // Absolute, because this one is meant to be copied out of the page and
  // pasted into a calendar app as a subscription - a relative /feeds/... path
  // means nothing outside this document.
  const feedUrl = new URL(`/feeds/${category}/${page.slug}.ics`, Astro.site).href;
  const crumbs = [
    ROOT_CRUMB,
    ...ancestorCrumbs(segments),
    { name: meta.title, href: `/${category}/${page.slug}/` },
  ];
  const structuredData = graph([
    breadcrumbNode(absoluteCrumbs(crumbs)),
    ...(events.length > 0
      ? [
          datasetNode({
            name: meta.title,
            description,
            url: pageUrl,
            distributions: [
              { url: new URL(`/api/v1/${category}/${page.slug}.json`, Astro.site).href, encodingFormat: "application/json" },
              { url: feedUrl, encodingFormat: "text/calendar" },
            ],
          }),
          ...(eventLocation
            ? structuredEvents.map((e) =>
                eventNode({
                  name: e.label,
                  startDate: e.date,
                  url: pageUrl,
                  description,
                  image: eventImage,
                  location: eventLocation,
                }),
              )
            : []),
        ]
      : []),
  ]);
  // Every year in the list has a page of its own (lib/year-pages.ts generates
  // them uncapped), so the pills are always links - one control, one behaviour,
  // on every page of the site.
  const yearLinks = yearsFor(page).map((year) => ({ year, href: yearHref(category, page.slug, year) }));
  // The evergreen page has no single "year" of its own - the current year is
  // the one a grid can usefully show; below the density threshold (spec's own
  // escape hatch, see lib/year-grid.ts) the list below stays the only view.
  const gridYear = new Date().getFullYear();
  const yearGrid = buildYearGrid(gridYear, eventsInYear(events, gridYear));
  const grid: YearGridMonth[] | null = shouldRenderYearGrid(yearGrid) ? yearGrid : null;
  return { page, category, meta, data, events, years, nextEvent, preview, columns, rowsPreview, crumbs, description, structuredData, pageUrl, feedUrl, yearLinks, gridYear, grid };
}

function buildYearView(page: Page, year: number) {
  // Overlap-filtered, so a Weihnachtsferien window running 23.12. -> 06.01.
  // appears on BOTH years' pages instead of vanishing from January's.
  const events = eventsInYear(getPageEvents(page), year);
  // Ratio-carrying rows (Urlaubsfenster) lead with the best ratio, everything
  // else stays chronological - decided by the data, not by the category name.
  const sorted = events.some((e) => e.value !== undefined)
    ? [...events].sort((a, b) => (b.value ?? 0) - (a.value ?? 0))
    : events;
  const copy = yearCopy(page, year, sorted);
  const yearLinks = yearsFor(page).map((y) => ({ year: y, href: yearHref(page.category, page.slug, y) }));
  // Same "what's next" affordance the evergreen page has, just bounded to this
  // year - a future year simply leads with its first entry, a past one gets
  // nothing rather than a stale "next".
  const todayIso = new Date().toISOString().slice(0, 10);
  const nextEvent = [...events].filter((e) => e.date >= todayIso).sort((a, b) => a.date.localeCompare(b.date))[0];
  const pageUrl = new URL(yearHref(page.category, page.slug, year), Astro.site).href;
  const feedUrl = new URL(`/feeds/${page.category}/${page.slug}.ics`, Astro.site).href;
  // Same year elsewhere - the same state in the other topics, or this page's
  // siblings in its own category. Filtered against the index, so a link can
  // only point at a year page that was actually generated.
  const siblings = siblingPages(page, getAllPages())
    .filter((p) => (yearIndex().get(`${p.category}/${p.slug}`) ?? []).includes(year))
    .map((p) => ({ href: yearHref(p.category, p.slug, year), label: yearLabel(p, year) }));
  const crumbs = [
    ROOT_CRUMB,
    ...ancestorCrumbs(page.category.split("/")),
    { name: page.meta.title, href: `/${page.category}/${page.slug}/` },
    { name: String(year), href: yearHref(page.category, page.slug, year) },
  ];
  const structuredData = graph([
    breadcrumbNode(absoluteCrumbs(crumbs)),
    datasetNode({
      name: copy.h1,
      description: copy.description,
      url: pageUrl,
      distributions: [
        { url: new URL(`/api/v1/${page.category}/${page.slug}.json`, Astro.site).href, encodingFormat: "application/json" },
        { url: feedUrl, encodingFormat: "text/calendar" },
      ],
    }),
    // Only when there ARE questions - an empty FAQPage node is invalid, and
    // every question here is rendered visibly below (Google requires the
    // on-page counterpart, see lib/structured-data.ts's faqNode).
    ...(copy.faq.length > 0 ? [faqNode(copy.faq)] : []),
  ]);
  const yearGrid = buildYearGrid(year, events);
  const grid: YearGridMonth[] | null = shouldRenderYearGrid(yearGrid) ? yearGrid : null;
  return {
    page,
    year,
    copy,
    events: sorted,
    siblings,
    yearLinks,
    nextEvent,
    crumbs,
    evergreenHref: `/${page.category}/${page.slug}/`,
    feedUrl,
    pageUrl,
    structuredData,
    noindex: !shouldIndexYear(page.category, year, sorted.length),
    grid,
  };
}

const categoryView = props.kind === "category" ? buildCategoryView(props.node) : null;
const pageView = props.kind === "page" ? buildPageView(props.page) : null;
const yearView = props.kind === "year" ? buildYearView(props.page, props.year) : null;
---

{
  categoryView && (
    <Layout title={categoryView.categoryMeta.name} description={categoryView.description} structuredData={categoryView.structuredData}>
      <Breadcrumbs crumbs={categoryView.crumbs} />
      <h1>{categoryView.categoryMeta.name}</h1>

      {
        categoryView.childCategories.length > 0 && (
          <ul class="cards">
            {categoryView.childCategories.map((c) => <li><a href={`/${c.path}/`}>{c.meta.name}</a></li>)}
          </ul>
        )
      }

      {
        categoryView.bandChart && (
          <>
            <h2>Übersicht</h2>
            <BandChart
              chart={categoryView.bandChart.chart}
              primaryLabel={categoryView.bandChart.primaryLabel}
              accentLabel={categoryView.bandChart.accentLabel}
            />
          </>
        )
      }

      {
        categoryView.sortedPages.length > 0 && (
          <ul class="cards">
            {categoryView.sortedPages.map((p) => (
              <li><a href={`/${categoryView.node.path}/${p.slug}/`}>{p.meta.title}</a></li>
            ))}
          </ul>
        )
      }
    </Layout>
  )
}

{
  pageView && (
    <Layout title={pageView.meta.title} description={pageView.description} structuredData={pageView.structuredData}>
      <Breadcrumbs crumbs={pageView.crumbs} />
      <h1>{pageView.meta.title}</h1>
      {/* `intro` where a page wants its visible lead to differ from its meta
          description (see lib/pages-schema.ts), the description otherwise. */}
      {(pageView.meta.intro || pageView.meta.description) && (
        <p>{pageView.meta.intro || pageView.meta.description}</p>
      )}


      {
        pageView.nextEvent && (
          <p class="next-event">
            Nächster Termin:{" "}
            <a
              class="link-button"
              href={`/kalender/?day=${pageView.nextEvent.date}&layers=${pageView.category.replace(/\//g, "-")}--${pageView.page.slug}`}
            >
              {pageView.nextEvent.label} · {formatDateWithWeekday(pageView.nextEvent.date)}
            </a>
          </p>
        )
      }

      {
        pageView.meta.tags.length > 0 && (
          <p class="tags">
            {pageView.meta.tags.map((tag) => (
              <a class="badge" href={`/themen/${tag}/`}>{tag}</a>
            ))}
          </p>
        )
      }

      <div class="actions">
        <a class="link-button" href={`/api/v1/${pageView.category}/${pageView.page.slug}.json`}>
          <Braces size={16} aria-hidden="true" /> JSON
        </a>
        {pageView.events.length > 0 && (
          /* ponytail: <details>/<summary> IS the reveal - native disclosure,
          focusable, keyboard-operable, zero JS and zero state. Only the
          copy button needs a script. */
          <details class="feed">
            <summary><span class="link-button"><CalendarPlus size={16} aria-hidden="true" /> ICS abonnieren</span></summary>
            <div class="feed-panel">
              <p>Neue Termine kommen automatisch dazu:</p>
              <input class="feed-url" type="text" readonly value={pageView.feedUrl} aria-label="Adresse des ICS-Kalenders" />
              <button type="button" class="link-button copy-feed" data-feed-url={pageView.feedUrl}>
                <Copy size={14} aria-hidden="true" /> Kopieren
              </button>
              <span class="copy-status" role="status" aria-live="polite" />
              <p>
                Oder <a class="feed-download" href={`/feeds/${pageView.category}/${pageView.page.slug}.ics`}>
                  <Download size={13} aria-hidden="true" /> einmalig als .ics-Datei</a> - ohne Updates.
              </p>
            </div>
          </details>
        )}
      </div>

      {
        pageView.events.length > 0 && (
          <>
            <h2>Termine</h2>
            {pageView.grid && (
              <YearGrid
                year={pageView.gridYear}
                grid={pageView.grid}
                eventLabel={pageView.meta.title}
                category={pageView.category}
                slug={pageView.page.slug}
              />
            )}
            {/* On the per-state topics the pills navigate to the year pages
                (crawlable entry points, and this evergreen page is their hub);
                everywhere else they stay the in-page filter. */}
            <DateListControls yearLinks={pageView.yearLinks} category={pageView.category} />
            <ul class="rows" id="year-rows">
              {pageView.events.map((e) => (
                <li id={e.date} data-year={toDate(e.date).getFullYear()}>
                  <span>{e.label}</span>
                  <a
                    class="date link-button"
                    href={`/kalender/?day=${e.date}&layers=${pageView.category.replace(/\//g, "-")}--${pageView.page.slug}`}
                  >
                    {formatDateWithWeekday(e.date)}{e.to && ` – ${formatDateWithWeekday(e.to)}`}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        pageView.columns.length > 0 && pageView.rowsPreview.length > 0 && (
          <>
            <h2>Tabelle (Auszug)</h2>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>{pageView.columns.map((c) => <th>{c}</th>)}</tr>
                </thead>
                <tbody>
                  {pageView.rowsPreview.map((row) => (
                    <tr>{pageView.columns.map((c) => <td>{row[c]}</td>)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          </>
        )
      }

      {
        pageView.preview && (
          <>
            <h2>Inhalt (Auszug)</h2>
            <p>{pageView.preview}</p>
          </>
        )
      }

      <SourceList sources={pageView.data.source} pageTitle={pageView.meta.title} pageUrl={pageView.pageUrl} />
    </Layout>
  )
}

{
  yearView && (
    <Layout title={yearView.copy.title} description={yearView.copy.description} structuredData={yearView.structuredData} noindex={yearView.noindex}>
      <Breadcrumbs crumbs={yearView.crumbs} />
      <h1>{yearView.copy.h1}</h1>
      <p>{yearView.copy.intro}</p>

      {
        yearView.nextEvent && (
          <p class="next-event">
            Nächster Termin:{" "}
            <a
              class="link-button"
              href={`/kalender/?day=${yearView.nextEvent.date}&layers=${yearView.page.category.replace(/\//g, "-")}--${yearView.page.slug}`}
            >
              {yearView.nextEvent.label} · {formatDateWithWeekday(yearView.nextEvent.date)}
            </a>
          </p>
        )
      }

      {
        yearView.page.meta.tags.length > 0 && (
          <p class="tags">
            {yearView.page.meta.tags.map((tag) => (
              <a class="badge" href={`/themen/${tag}/`}>{tag}</a>
            ))}
          </p>
        )
      }

      <div class="actions">
        <a class="link-button" href={`/api/v1/${yearView.page.category}/${yearView.page.slug}.json`}>
          <Braces size={16} aria-hidden="true" /> JSON
        </a>
        {/* Same feed as the evergreen page - Phase 1 changes no ICS feed; the
            year page only narrows the VIEW, while a subscription is meant to
            keep delivering past this year. */}
        <details class="feed">
          <summary><span class="link-button"><CalendarPlus size={16} aria-hidden="true" /> ICS abonnieren</span></summary>
          <div class="feed-panel">
            <p>Neue Termine kommen automatisch dazu:</p>
            <input class="feed-url" type="text" readonly value={yearView.feedUrl} aria-label="Adresse des ICS-Kalenders" />
            <button type="button" class="link-button copy-feed" data-feed-url={yearView.feedUrl}>
              <Copy size={14} aria-hidden="true" /> Kopieren
            </button>
            <span class="copy-status" role="status" aria-live="polite" />
            <p>
              Oder <a class="feed-download" href={`/feeds/${yearView.page.category}/${yearView.page.slug}.ics`}>
                <Download size={13} aria-hidden="true" /> einmalig als .ics-Datei</a>.
            </p>
          </div>
        </details>
      </div>

      {
        yearView.events.length > 0 && (
          <>
            <h2>Termine {yearView.year}</h2>
            {yearView.grid && (
              <YearGrid
                year={yearView.year}
                grid={yearView.grid}
                eventLabel={yearView.page.meta.title}
                category={yearView.page.category}
                slug={yearView.page.slug}
              />
            )}
            {/* The same pill row as the evergreen page, so "switch to 2027"
                looks and feels the same everywhere - here the current year is
                the active pill and "Alle" leads back to the evergreen page. */}
            <DateListControls
              yearLinks={yearView.yearLinks}
              category={yearView.page.category}
              allHref={yearView.evergreenHref}
              currentYear={yearView.year}
            />
            <ul class="rows" id="year-rows">
              {yearView.events.map((e) => (
                <li id={e.date} data-year={toDate(e.date).getFullYear()}>
                  <span>{e.label}</span>
                  <a
                    class="date link-button"
                    href={`/kalender/?day=${e.date}&layers=${yearView.page.category.replace(/\//g, "-")}--${yearView.page.slug}`}
                  >
                    {formatDateWithWeekday(e.date)}{e.to && ` – ${formatDateWithWeekday(e.to)}`}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        yearView.siblings.length > 0 && (
          <>
            <h2>Passend dazu {yearView.year}</h2>
            <ul class="cards">
              {yearView.siblings.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            </ul>
          </>
        )
      }

      {
        /* Rendered because it is real page content, and REQUIRED because the
        FAQPage JSON-LD above describes exactly this list. */
        yearView.copy.faq.length > 0 && (
          <>
            <h2>Häufige Fragen</h2>
            <dl class="faq">
              {yearView.copy.faq.map((item) => (
                <>
                  <dt>{item.question}</dt>
                  <dd>{item.answer}</dd>
                </>
              ))}
            </dl>
          </>
        )
      }

      <SourceList sources={yearView.page.data.source} pageTitle={yearView.copy.h1} pageUrl={yearView.pageUrl} />
    </Layout>
  )
}

<script>
  // Re-run per navigation - see the note in Layout.astro's ClientRouter: the
  // year pills swap this page for another one that has its own copy button.
  document.addEventListener("astro:page-load", () => {
    // ponytail: no clipboard fallback and no error path - the URL is already
    // sitting visible in a readonly input, so "select it yourself" is the
    // fallback, for free.
    const copyButton = document.querySelector<HTMLButtonElement>(".copy-feed");
    const copyStatus = document.querySelector<HTMLElement>(".copy-status");
    copyButton?.addEventListener("click", async () => {
      await navigator.clipboard.writeText(copyButton.dataset.feedUrl ?? "");
      if (copyStatus) {
        copyStatus.textContent = "Kopiert!";
        setTimeout(() => (copyStatus.textContent = ""), 1500);
      }
    });
  });
</script>

<style>
  .next-event {
    color: var(--muted);
  }
  .faq dt {
    font-weight: 600;
    margin-top: 0.9rem;
  }
  .faq dd {
    margin: 0.2rem 0 0;
    color: var(--muted);
  }
  .tags .badge {
    margin: 0 0.4rem 0.4rem 0;
    text-decoration: none;
  }
  .actions {
    display: flex;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1rem 0 1.5rem;
  }
  /* .link-button lives on a span INSIDE the summary, not on the summary
  itself. Overriding a <summary>'s `display` has a history of upsetting the
  disclosure marker and, reportedly, toggling; keeping the default sidesteps
  the question entirely and costs nothing, since <details> is a flex item of
  .actions and already shrink-to-fits around the pill. This rule only drops
  the triangle and restores the pointer. */
  .feed summary {
    cursor: pointer;
    list-style: none;
  }
  /* Pins the pill to the top of the summary's line box, so it lines up with
  the JSON pill next to it instead of sitting a few px lower. */
  .feed summary .link-button {
    vertical-align: top;
  }
  .feed summary::-webkit-details-marker {
    display: none;
  }
  .feed-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.6rem;
    max-width: 42rem;
  }
  .feed-panel p {
    width: 100%;
    margin: 0;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .feed-url {
    flex: 1;
    min-width: 10rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    padding: 0.3rem 0.5rem;
  }
  .copy-status {
    font-size: 0.85rem;
    color: var(--accent);
  }
  /* .link-button is already inline-flex with a gap, so the icons above need
  no rule of their own. This link is different: it sits mid-sentence, so it
  has to stay a normal inline box (an inline-flex one is atomic and would
  refuse to wrap, stranding "Oder" on its own line) - the icon is nudged
  onto the text baseline instead. */
  .feed-download svg {
    vertical-align: -0.15em;
    margin-right: 0.25rem;
  }
</style>
